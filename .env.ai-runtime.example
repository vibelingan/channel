# Local/runtime configuration for the Channel AI BFF and worker.
# Copy to a gitignored file or inject through CloudBase Run secrets. Never put
# production values in this example.
DATABASE_URL=postgres://ai:ai@localhost:55433/ai_assistant
PORT=58080
CORS_ALLOWED_ORIGINS=http://localhost:4321
AI_CREDENTIAL_TTL_SECONDS=86400
AI_GLOBAL_REQUESTS_PER_MINUTE=600
AI_IP_REQUESTS_PER_MINUTE=60
AI_IP_HASH_SECRET=<random-secret-at-least-24-characters>
# Set only when the CloudBase Run ingress is the trusted X-Forwarded-For writer.
AI_TRUST_PROXY=0
AI_ENGINE_ID=fake
AI_ENGINE_VERSION=0.1.0
AI_PROFILE_ID=channel-public-v1
AI_WORKER_LEASE_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_STREAM_DURATION_MS=55000
AI_MAX_TOOL_CALLS=2

# Production adapter (server-side secrets only). The worker refuses to start
# until citations have been live-verified and this flag is deliberately set.
# AI_ENGINE_ID=anythingllm
# AI_ENGINE_VERSION=<reviewed-version>
# AI_ENGINE_IMAGE_DIGEST=sha256:<reviewed-digest>
# ANYTHINGLLM_BASE_URL=https://kb.example.com
# ANYTHINGLLM_API_KEY=<secret-manager-reference>
# ANYTHINGLLM_WORKSPACE_SLUG=<dedicated-public-workspace>
# AI_KNOWLEDGE_CREDENTIAL_ID=<approved-attested-credential-id>
# ANYTHINGLLM_CITATIONS_VERIFIED=0
# ANYTHINGLLM_CREDENTIAL_ROTATION=1
