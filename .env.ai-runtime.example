# Local/runtime configuration for the Channel AI BFF and worker.
# Copy to a gitignored file or inject through CloudBase Run secrets. Never put
# production values in this example.
DATABASE_URL=postgres://ai:ai@localhost:55433/ai_assistant
PORT=58080
CORS_ALLOWED_ORIGINS=http://localhost:4321
AI_CREDENTIAL_TTL_SECONDS=86400
AI_GLOBAL_REQUESTS_PER_MINUTE=600
AI_IP_REQUESTS_PER_MINUTE=60
# New questions only (retries are free). Every limit ends with its own window.
AI_CONVERSATION_QUESTIONS_PER_MINUTE=6
AI_CONVERSATION_QUESTIONS_PER_DAY=60
AI_IP_QUESTIONS_PER_DAY=200
# After this many refused questions, the conversation waits out the cooldown window.
AI_QUESTION_REFUSALS_BEFORE_COOLDOWN=5
AI_QUESTION_COOLDOWN_SECONDS=600
# After this many idle answers in a row (fixed small-talk replies, out-of-scope
# refusals), further questions share 3 per 10 minutes until one is not idle.
AI_IDLE_REPLIES_BEFORE_SLOWDOWN=5
AI_IDLE_QUESTIONS_PER_WINDOW=3
AI_IDLE_WINDOW_SECONDS=600
AI_IP_HASH_SECRET=<random-secret-at-least-24-characters>
# Set only when the CloudBase Run ingress is the trusted X-Forwarded-For writer.
AI_TRUST_PROXY=0
AI_ENGINE_ID=fake
AI_ENGINE_VERSION=0.1.0
AI_PROFILE_ID=channel-public-v1
AI_WORKER_LEASE_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_STREAM_DURATION_MS=55000
AI_MAX_TOOL_CALLS=0
AI_APPROVED_SOURCE_PREFIX=channelkb
AI_SITE_ORIGIN=http://localhost:4321
# Model input, estimated (CJK 1 token/char, else 3 chars/token) and used only to
# decide what to leave out; billing uses the usage the provider returns.
AI_HISTORY_TOKENS=6000
AI_MAX_INPUT_TOKENS_PER_CALL=16000
AI_MAX_INPUT_TOKENS_PER_QUESTION=32000

# Website VibeKB adapter (server-side configuration only; no deployment implied).
# Explicitly replace AI_MAX_TOOL_CALLS=0 above with 8 for this adapter.
# AI_ENGINE_ID=vibekb
# AI_ENGINE_VERSION=1.0.0
# AI_MODEL_BASE_URL=https://tokenhub-intl.tencentmaas.com/plan/v3
# AI_MODEL_ID=deepseek/deepseek-v4-pro
# AI_MODEL_API_KEY=<dedicated-server-secret>
# AI_MODEL_THINKING_MODE=disabled
# AI_PUBLIC_CATALOG_ORIGIN=https://<current-approved-public-api-origin>
# AI_INQUIRY_ENABLED=1
# AI_INQUIRY_BASE_URL=https://<approved-channel-sales-service>
# AI_INQUIRY_TOKEN=<dedicated-server-intake-secret>
# VIBEKB_MCP_URL=https://<approved-private-mcp-ingress>/mcp
# VIBEKB_MCP_API_KEY=<server-secret>
# VIBEKB_PUBLIC_WORKSPACE_ID=2
# VIBEKB_PUBLIC_DOCUMENT_IDS=12
# VIBEKB_PUBLIC_TAG=对外公开
# VIBEKB_MCP_ALLOW_LOOPBACK_HTTP=0
# AI_MAX_TOOL_CALLS=8
# AI_MAX_STREAM_DURATION_MS=120000
# AI_WORKER_LEASE_SECONDS=150
# AI_ENGINE_PROVENANCE_KIND=git
# AI_ENGINE_GIT_COMMIT=<reviewed-40-hex-commit>
# AI_ENGINE_GIT_REPOSITORY=vibelingan/channel
# AI_ENGINE_CONFIG_DIGEST=sha256:<64-hex-digest-over-applied-configuration>

# Legacy adapter kept for existing callers. The new website path uses VibeKB.
# The worker refuses this legacy path until citations are live-verified.
# Production adapter (server-side secrets only). The worker refuses to start
# until citations have been live-verified and this flag is deliberately set.
# AI_ENGINE_ID=anythingllm
# AI_ENGINE_VERSION=<reviewed-version>
# What produced the answer. Say WHICH KIND first, then that kind's fields.
#   oci -> AI_ENGINE_IMAGE_DIGEST=sha256:<64 hex>
#   git -> AI_ENGINE_GIT_COMMIT=<40 hex> + AI_ENGINE_GIT_REPOSITORY=<owner/repo>
# The hosted knowledge base is a git checkout on a VM, so it is `git`. Putting a
# commit sha under AI_ENGINE_IMAGE_DIGEST is refused at startup rather than
# stored, because an auditor reading a digest believes they can pull it.
# AI_ENGINE_PROVENANCE_KIND=git
# AI_ENGINE_GIT_COMMIT=<40-hex-commit>
# AI_ENGINE_GIT_REPOSITORY=<owner/repo>
# AI_ENGINE_CONFIG_DIGEST=sha256:<64-hex-digest-over-applied-configuration>
# KB_BASE_URL=https://kb.example.com
# KB_API_KEY=<secret-manager-reference>
# KB_WORKSPACE_SLUG=<dedicated-public-workspace>
# KB_WORKSPACE_ID=<vendor-workspace-id-returned-by-the-probe>
# AI_KNOWLEDGE_CREDENTIAL_ID=<approved-attested-credential-id>
# KB_CITATIONS_VERIFIED=0
# KB_CREDENTIAL_ROTATION=1
# AI_CORPUS_GENERATION=<generation-returned-by-ai-ingest>
# AI_KB_EVIDENCE_JSON=<single-line-secret-free-probe-evidence>
# AI_APPROVED_SOURCE_PREFIX=channelkb
# AI_SITE_ORIGIN=https://www.example.com
