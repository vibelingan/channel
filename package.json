{
  "name": "channel-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Channel portal \u2014 Astro + TailwindCSS site with a registry-driven admin backed by wx-server-sdk (CloudBase).",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npx pnpm --filter @vibelingan-channel/site dev",
    "dev:api": "npx pnpm --filter @vibelingan-channel/local-server dev",
    "build": "npx pnpm --filter @vibelingan-channel/site build",
    "build:functions": "npx pnpm -r --filter \"./apps/functions/**\" build",
    "package:functions": "npx pnpm build:functions && node scripts/package-functions.mjs",
    "preview": "npx pnpm --filter @vibelingan-channel/site preview",
    "deploy:cloudbase:test": "node scripts/deploy-cloudbase-test.mjs",
    "verify:cloudbase-sdk": "node scripts/verify-cloudbase-sdk-contract.mjs",
    "smoke:cloudbase": "node scripts/smoke-cloudbase-deploy.mjs",
    "smoke:functions": "node scripts/smoke-function-artifacts.mjs",
    "test": "pnpm test:deploy-smoke && pnpm -r test",
    "test:deploy-smoke": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts",
    "test:e2e:media-upload": "playwright test tests/e2e/media-upload.spec.ts tests/e2e/media-upload-ui.spec.ts",
    "test:e2e:oem-upload": "playwright test tests/e2e/oem-upload.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "typecheck": "npx pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" typecheck && npx pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "npx biome check .",
    "format": "npx biome format --write .",
    "test:ai:store": "node scripts/probe-ai-store.mjs --url ${DATABASE_URL:-postgres://ai:ai@localhost:55432/ai_assistant}",
    "test:ai:kb": "node --env-file-if-exists=.env.ai-probe scripts/probe-anythingllm.mjs",
    "build:ai": "pnpm --filter @vibelingan-channel/ai-store build && pnpm --filter @vibelingan-channel/ai-bff build && pnpm --filter @vibelingan-channel/ai-worker build",
    "test:ai:runtime": "pnpm --filter @vibelingan-channel/ai-store test && pnpm --filter @vibelingan-channel/ai-bff test && pnpm --filter @vibelingan-channel/ai-worker test",
    "migrate:ai": "pnpm --filter @vibelingan-channel/ai-store migrate",
    "migrate:ai:down": "pnpm --filter @vibelingan-channel/ai-store migrate:down",
    "smoke:ai:bff": "node scripts/smoke-ai-bff.mjs",
    "smoke:ai:worker": "node scripts/smoke-ai-worker.mjs",
    "dev:ai": "docker compose -f docker-compose.ai.yml up -d --build postgres ai-bff ai-worker",
    "dev:ai:full": "docker compose --env-file .env.ai -f docker-compose.ai.yml up -d postgres anythingllm",
    "dev:ai:down": "docker compose -f docker-compose.ai.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.19.21",
    "pg": "^8.23.0",
    "typescript": "^5.6.3",
    "yaml": "2.9.0"
  }
}
