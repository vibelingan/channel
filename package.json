{
  "name": "channel-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Channel portal — Astro + TailwindCSS site with a registry-driven admin backed by wx-server-sdk (CloudBase).",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npx pnpm --filter @vibelingan-channel/site dev",
    "dev:api": "npx pnpm --filter @vibelingan-channel/local-server dev",
    "build": "npx pnpm --filter @vibelingan-channel/site build",
    "build:functions": "npx pnpm -r --filter \"./apps/functions/**\" build",
    "package:functions": "npx pnpm build:functions && node scripts/package-functions.mjs",
    "preview": "npx pnpm --filter @vibelingan-channel/site preview",
    "deploy:cloudbase:test": "node scripts/deploy-cloudbase-test.mjs",
    "verify:cloudbase-sdk": "node scripts/verify-cloudbase-sdk-contract.mjs",
    "smoke:cloudbase": "node scripts/smoke-cloudbase-deploy.mjs",
    "smoke:functions": "node scripts/smoke-function-artifacts.mjs",
    "test": "pnpm test:deploy-smoke && pnpm -r test",
    "test:deploy-smoke": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts",
    "test:e2e:catalog": "playwright test tests/e2e/header-navigation.spec.ts tests/e2e/catalog-hub.spec.ts tests/e2e/catalog-family-routes.spec.ts tests/e2e/catalog-category.spec.ts tests/e2e/sku-detail.spec.ts",
    "test:e2e:catalog-admin": "playwright test tests/e2e/admin-product-family-tabs.spec.ts tests/e2e/admin-product-form.spec.ts tests/e2e/admin-alibaba-detail-inspection.spec.ts",
    "test:e2e:catalog-admin-local": "node scripts/run-catalog-admin-local-e2e.mjs",
    "test:e2e:media-upload": "playwright test tests/e2e/media-upload.spec.ts tests/e2e/media-upload-ui.spec.ts",
    "test:e2e:oem-upload": "playwright test tests/e2e/oem-upload.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "typecheck": "npx pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" typecheck && npx pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "npx biome check .",
    "format": "npx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.19.21",
    "typescript": "^5.6.3",
    "yaml": "2.9.0"
  }
}
