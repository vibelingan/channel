# Copy to .env.ai-probe (gitignored). Never commit the real API key.
# Production must use HTTPS; the probe rejects remote HTTP by default.
ANYTHINGLLM_BASE_URL=https://kb.example.com
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=
ANYTHINGLLM_RETRIEVAL_QUERY=What does the company do?
ANYTHINGLLM_CHAT_QUERY=What does the company do?

# Diagnostic escape hatch only. A bearer token sent over HTTP is exposed in
# plaintext to the network path. Leave false for normal use.
ALLOW_INSECURE_ANYTHINGLLM=false
