{
  "name": "@vibelingan-channel/fn-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Generic, registry-driven CRUD cloud function for the admin portal. Exposes secure list/get/create/update/remove over every registered collection.",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./handler": "./src/handler.ts",
    "./catalog-import-service": "./src/catalog-import-service.ts",
    "./catalog-import-store": "./src/catalog-import-store.ts",
    "./catalog-import-publish": "./src/catalog-import-publish.ts",
    "./catalog-import-media": "./src/catalog-import-media.ts"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibelingan-channel/auth": "workspace:*",
    "@vibelingan-channel/catalog-import": "workspace:*",
    "@vibelingan-channel/db": "workspace:*",
    "@vibelingan-channel/email": "workspace:*",
    "@vibelingan-channel/media-storage": "workspace:*",
    "@vibelingan-channel/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4"
  }
}
