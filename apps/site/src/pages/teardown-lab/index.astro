---
import PageHero from '../../components/PageHero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TeardownCard from '../../components/TeardownCard.astro';
import { getAllReports } from '../../data/teardownReports.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OEM_INQUIRY_HREF } from '../../lib/site-navigation.ts';

const content = getSiteContent(DEFAULT_LOCALE);
const { brand, nav, footer } = content;
const reports = getAllReports();

const avgMargin = reports.reduce((sum, r) => sum + r.estMargin, 0) / reports.length;
const totalReports = reports.length;
---

<BaseLayout
  title={`Teardown Lab — ${brand.name}`}
  description="Weekly deep-dive teardown reports analyzing crowdfunded hardware champions. We reverse-engineer the products, estimate BOM costs, and reveal manufacturing risks."
  lang="en"
>
  <SiteHeader brand={brand} nav={nav} />

  <main>
    <PageHero
      eyebrow="Market Insights"
      heading="Teardown Lab"
      subheading="Weekly deep-dive reports reverse-engineering crowdfunded hardware champions. We tear down the products, estimate BOM costs, and reveal manufacturing risks — giving you the intelligence to build better products."
    />

    <!-- Stats strip -->
    <section class="border-b border-slate-200 bg-surface-alt">
      <div class="mx-auto max-w-[var(--width-container)] px-4 py-10 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-2 gap-6 sm:grid-cols-3">
          <div class="reveal">
            <dt class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Teardown Reports</dt>
            <dd class="mt-1 font-display text-3xl font-bold text-brand-600">{totalReports}</dd>
          </div>
          <div class="reveal">
            <dt class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Avg. Hardware Margin</dt>
            <dd class="mt-1 font-display text-3xl font-bold text-brand-600">{avgMargin.toFixed(2)}%</dd>
          </div>
          <div class="reveal col-span-2 sm:col-span-1">
            <dt class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Years Supply Chain Data</dt>
            <dd class="mt-1 font-display text-3xl font-bold text-brand-600">20+</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Report cards -->
    <section class="py-16 sm:py-20">
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <div class="reveal mb-10 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
            Latest Reports
          </p>
          <h2 class="mt-3 font-display text-2xl font-bold text-ink sm:text-3xl">
            What's inside the lab
          </h2>
          <p class="mt-3 text-lg leading-relaxed text-ink-soft">
            Each report covers the full picture: market positioning, a component-level
            hardware teardown, an itemised BOM cost estimate, and the manufacturing risks
            you'll face replicating it.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reports.map((report) => (
            <TeardownCard report={report} />
          ))}
        </div>
      </div>
    </section>

    <!-- Methodology / CTA -->
    <section class="bg-surface-dark text-white">
      <div class="mx-auto max-w-[var(--width-container)] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="reveal grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-300">
              Our Methodology
            </p>
            <h2 class="mt-4 font-display text-2xl font-bold sm:text-3xl">
              How we estimate BOM &amp; margin
            </h2>
            <p class="mt-5 text-base leading-relaxed text-slate-300">
              Each teardown combines physical disassembly with bill-of-materials
              benchmarking against current Shenzhen component pricing. Cost figures
              are ex-work estimates at the stated MOQ and include tooling amortization,
              assembly, and testing — not retail markup, shipping, or tariffs.
            </p>
          </div>
          <div class="rounded-[var(--radius-card)] border border-white/10 bg-white/5 p-8 backdrop-blur">
            <h3 class="font-display text-lg font-semibold text-white">
              Want a teardown of your product?
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">
              We deliver the same depth of analysis for your concept or SKU — from BOM
              estimation to manufacturing risk mitigation — so you can launch with
              confidence.
            </p>
            <a
              href={OEM_INQUIRY_HREF}
              class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-base font-semibold text-brand-950 transition hover:bg-accent-400"
            >
              Start an OEM project
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
