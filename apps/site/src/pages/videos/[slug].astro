---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { factoryVideoAsset, factoryVideoRangePath } from '../../lib/seo/factory-video.ts';
import {
  type WatchVideo,
  publicWatchVideos,
  watchPageDescriptor,
} from '../../lib/seo/video-record.ts';

export function getStaticPaths() {
  return publicWatchVideos().map((video) => ({ params: { slug: video.id }, props: { video } }));
}
interface Props {
  video: WatchVideo;
}
const { video } = Astro.props;
const { brand, nav, footer } = getSiteContent(DEFAULT_LOCALE);
const origin = Astro.site ?? Astro.url.origin;
const seconds = Math.round(video.durationSeconds);
const page = watchPageDescriptor(video, origin, brand.name);
const rangePlaybackPath =
  video.src === factoryVideoAsset.source && video.sourceSha256 === factoryVideoAsset.sha256
    ? factoryVideoRangePath
    : undefined;
---

<BaseLayout page={page} lang="en" socialImage={{ path: video.poster.src,
  alt: 'Factory premises shown in the opening scene of the tour',
  width: video.poster.width, height: video.poster.height, mimeType: 'image/webp' }}>
  <SiteHeader brand={brand} nav={nav} />
  <main class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-8">
    <header class="mb-5">
      <nav aria-label="Breadcrumb" class="mb-3 text-sm text-ink-soft">
        <a href="/" class="underline underline-offset-4">Home</a>
        <span aria-hidden="true"> / </span><span aria-current="page">Factory overview</span>
      </nav>
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{video.title}</h1>
      <p id="video-format" class="mt-3 text-sm text-ink-soft">
        <time datetime={`PT${video.durationSeconds}S`}>{Math.floor(seconds / 60)} min {seconds % 60} sec</time>
        <span aria-hidden="true"> · </span>Silent video
        <span aria-hidden="true"> · </span><a href="#video-summary" class="underline underline-offset-4">Read the scene summary</a>
      </p>
    </header>

    <video controls playsinline preload="none" width={video.width} height={video.height}
      poster={video.poster.src} aria-label={video.title} aria-describedby="video-format video-description"
      class="block aspect-[4/3] w-full rounded-[var(--radius-card)] bg-black object-contain shadow-[var(--shadow-card)]">
      {rangePlaybackPath && <source src={rangePlaybackPath} type="video/mp4" />}
      <source src={video.src} type="video/mp4" />
      <p>Your browser cannot play this video. <a href={video.src}>Open the video file</a> or read the scene summary below.</p>
    </video>

    <section id="video-summary" aria-labelledby="video-summary-title" class="py-8 sm:py-10">
      <h2 id="video-summary-title" class="font-display text-2xl font-semibold text-ink">About the tour</h2>
      <p id="video-description" class="mt-3 leading-relaxed text-ink-soft">{video.description}</p>
      <p class="mt-3 leading-relaxed text-ink-soft">This video has no audio. The scene summary provides a text description of the tour.</p>
      <dl class="mt-6 space-y-5">
        {video.sceneSummary.map(scene => <div>
          <dt class="font-semibold text-ink">{scene.heading}</dt>
          <dd class="mt-1 leading-relaxed text-ink-soft">{scene.text}</dd>
        </div>)}
      </dl>
      <p class="mt-7 leading-relaxed text-ink-soft">Planning a product? Review our <a href="/oem/" class="font-medium text-brand-600 underline underline-offset-4">OEM development services</a> and discuss the requirements for your project with our team.</p>
    </section>
  </main>
  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
