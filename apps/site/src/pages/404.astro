---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = getSiteContent(DEFAULT_LOCALE);
---
<BaseLayout title={`Page not found | ${site.brand.name}`} description="The page may have moved or is no longer available. Browse our products or return to the home page." canonicalPath="/404/" robots="noindex,follow">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main data-not-found-page class="mx-auto max-w-[var(--width-container)] px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.12em] text-brand-600">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl">Page not found</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">The page may have moved or is no longer available.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/" class="inline-flex min-h-11 items-center justify-center bg-accent-500 px-6 py-3 font-semibold text-brand-950 hover:bg-accent-400">Back to home</a>
      <a href="/headphones/" class="inline-flex min-h-11 items-center justify-center border border-slate-300 bg-white px-6 py-3 font-semibold text-ink hover:border-brand-300 hover:text-brand-700">Browse products</a>
    </div>
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
</BaseLayout>
