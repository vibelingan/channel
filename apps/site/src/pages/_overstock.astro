---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DEFAULT_LOCALE, getOverstockContent } from '../i18n/overstock.ts';
import { getSiteContent } from '../i18n/site.ts';
import { ProductGrid } from '../islands/shop/ProductGrid.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = getSiteContent();
const os = getOverstockContent(DEFAULT_LOCALE);
const { brand, footer } = site;
const shopNav = { items: os.shopNav };
const config = {
  apiPath: '/api/overstock',
  detailPath: '/overstock-item',
  fallbackImage: '/api/images/_placeholder',
  enableCart: true,
  showStock: true,
};
---

<BaseLayout title={`${os.meta.title} — ${brand.name}`} description={os.meta.description} lang="en">
  <SiteHeader brand={brand} nav={shopNav} showName={false} />

  <main>
    <!-- Catalog header -->
    <section class="border-b border-slate-200 bg-surface-alt">
      <div class="mx-auto max-w-[var(--width-container)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-600">
          {os.list.eyebrow}
        </p>
        <h1 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">
          {os.list.heading}
        </h1>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-soft">
          {os.list.subheading}
        </p>
      </div>
    </section>

    <!-- Catalog grid (React island) -->
    <section class="py-10 sm:py-12">
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <ProductGrid content={os.list} config={config} inquiry={os.inquiry} client:only="react" />
      </div>
    </section>
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
