---
import AIHero from '../components/AIHero.astro';
import CTASection from '../components/CTASection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import FactorySection from '../components/FactorySection.astro';
import OemProcessSection from '../components/OemProcessSection.astro';
import OurTeamSection from '../components/OurTeamSection.astro';
import QualityTestingSection from '../components/QualityTestingSection.astro';
import ServiceGridSection from '../components/ServiceGridSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WhyChooseUsSection from '../components/WhyChooseUsSection.astro';
import { getOemContent } from '../i18n/oem.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { AssistantWidget } from '../islands/ai/AssistantWidget.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';

const content = getSiteContent(DEFAULT_LOCALE);
const { submit } = getOemContent(DEFAULT_LOCALE);
const {
  brand,
  nav,
  hero,
  services,
  oemProcess,
  factory,
  ourPeople,
  whyChooseUs,
  quality,
  certifications,
  ctaSection,
  footer,
} = content;
---

<BaseLayout title={`${brand.name} — ${brand.tagline}`} description={hero.subheading} lang="en">
  <SiteHeader brand={brand} nav={nav} />

  <main>
    {/* P2: Hero — One-stop OEM manufacturing */}
    <AIHero hero={hero} />

    {/* P3: What We Do — Traditional vs AI workflow comparison */}
    <ServiceGridSection services={services} />

    {/* P4: OEM Development Process — 10-step workflow */}
    <OemProcessSection process={oemProcess} />

    {/* P5: Factory & Team Strength */}
    <FactorySection factory={factory} />

    {/* Our Team — people & global presence */}
    <OurTeamSection people={ourPeople} />

    {/* P7: Why Choose Us */}
    <WhyChooseUsSection why={whyChooseUs} />

    {/* Quality & Testing — in-house reliability lab */}
    <QualityTestingSection quality={quality} />

    {/* P8: Certifications & Global Clients */}
    <CertificationsSection certs={certifications} />

    {/* P9: CTA */}
    <CTASection cta={ctaSection} submit={submit} />
  </main>

  <SiteFooter brand={brand} footer={footer} />
  <AssistantWidget client:load />
</BaseLayout>
