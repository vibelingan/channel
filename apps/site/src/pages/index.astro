---
import ContentSection from '../components/ContentSection.astro';
import HeroVideo from '../components/HeroVideo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

// Region/language is fixed to en-US for now. Add more locale markdown files
// under src/i18n/content/ to support additional regions.
const content = getSiteContent(DEFAULT_LOCALE);
const { brand, nav, hero, sections, footer } = content;
---

<BaseLayout title={`${brand.name} — ${brand.tagline}`} description={hero.subheading} lang="en">
  <SiteHeader brand={brand} nav={nav} />

  <main>
    <HeroVideo hero={hero} />

    {sections.map((section, index) => <ContentSection section={section} index={index} />)}
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
