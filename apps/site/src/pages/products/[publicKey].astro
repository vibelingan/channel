---
import { publicCatalogImageApiOrigin } from '../../../../../scripts/release/site-policy.mjs';
import AssistantHost from '../../components/AssistantHost.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCatalogContent, getSharedDetailContent } from '../../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import { ProductLanding, initialProductImagePreload } from '../../islands/shop/ProductLanding.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productKey, productPath } from '../../lib/seo/product-identity.ts';
import { duplicateProductTitleIds, productPageDescriptor } from '../../lib/seo/product-page.ts';
import { type ProductSnapshotEntry, readProductSnapshot } from '../../lib/seo/product-snapshot.ts';

export async function getStaticPaths() {
  const snapshot = await readProductSnapshot(import.meta.env.SITE_URL || 'http://localhost:4321');
  const site = getSiteContent(DEFAULT_LOCALE);
  const duplicateIds = duplicateProductTitleIds(snapshot.products, site.brand.name);
  return snapshot.products.map((entry) => ({
    params: { publicKey: productKey(entry.product._id) },
    props: { entry, duplicateName: duplicateIds.has(entry.product._id) },
  }));
}
interface Props {
  entry: ProductSnapshotEntry;
  duplicateName: boolean;
}
const { entry, duplicateName } = Astro.props;
const site = getSiteContent(DEFAULT_LOCALE);
const content = getCatalogContent(DEFAULT_LOCALE);
const copy = getSharedDetailContent(DEFAULT_LOCALE);
// This storefront's existing /api/images route serves the same public API.
const heroImageApiOrigin = publicCatalogImageApiOrigin(
  Astro.site?.origin,
  import.meta.env.PUBLIC_API_BASE_URL,
);
const hero = initialProductImagePreload(entry.product, entry.detail, heroImageApiOrigin);
const page = productPageDescriptor(
  entry,
  (Astro.site ?? Astro.url.origin).toString(),
  site.brand.name,
  duplicateName,
);
---
<BaseLayout page={page}>
  <Fragment slot="resource-hints">
    {hero && (
      <link rel="preload" as="image" imagesrcset={hero.srcSet} imagesizes={hero.sizes} fetchpriority="high" referrerpolicy="no-referrer" />
    )}
  </Fragment>
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    <ProductLanding product={entry.product} bootstrap={entry.detail} content={content} copy={copy} canonicalPath={productPath(entry.product._id)} heroImageApiOrigin={heroImageApiOrigin} client:load />
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
  <AssistantHost />
</BaseLayout>
