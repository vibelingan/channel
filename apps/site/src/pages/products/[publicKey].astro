---
import { publicCatalogImageApiOrigin } from '../../../../../scripts/release/site-policy.mjs';
import AssistantHost from '../../components/AssistantHost.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCatalogContent, getSharedDetailContent } from '../../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import { ProductLanding } from '../../islands/shop/ProductLanding.tsx';
import { LegacySkuDetailPage } from '../../islands/shop/SkuDetailPage.tsx';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { productKey, productPath } from '../../lib/seo/product-identity.ts';
import {
  duplicateProductTitleIds,
  productBreadcrumbs,
  productPageDescriptor,
} from '../../lib/seo/product-page.ts';
import {
  conflictingProductPhotoPaths,
  productPreviewImage,
} from '../../lib/seo/product-preview-image.ts';
import { type ProductSnapshotEntry, readProductSnapshot } from '../../lib/seo/product-snapshot.ts';
import '../../styles/product.css';

export async function getStaticPaths() {
  const snapshot = await readProductSnapshot(import.meta.env.SITE_URL || 'http://localhost:4321');
  const site = getSiteContent(DEFAULT_LOCALE);
  const duplicateIds = duplicateProductTitleIds(snapshot.products, site.brand.name);
  const apiOrigin = publicCatalogImageApiOrigin(
    snapshot.siteOrigin,
    import.meta.env.PUBLIC_API_BASE_URL,
  );
  const conflictingPhotos = conflictingProductPhotoPaths(snapshot.products, apiOrigin);
  return snapshot.products.map((entry) => ({
    params: { publicKey: productKey(entry.product._id) },
    props: {
      entry,
      duplicateName: duplicateIds.has(entry.product._id),
      socialImage: productPreviewImage(entry, apiOrigin, conflictingPhotos),
    },
  }));
}
interface Props {
  entry: ProductSnapshotEntry;
  duplicateName: boolean;
  socialImage: ReturnType<typeof productPreviewImage>;
}
const { entry, duplicateName, socialImage } = Astro.props;
const site = getSiteContent(DEFAULT_LOCALE);
const canonicalPath = productPath(entry.product._id);
const catalogHref = productBreadcrumbs(entry.product).at(-2)?.href;
// This storefront's existing /api/images route serves the same public API.
const heroImageApiOrigin = publicCatalogImageApiOrigin(
  Astro.site?.origin,
  import.meta.env.PUBLIC_API_BASE_URL,
);
const page = productPageDescriptor(
  entry,
  (Astro.site ?? Astro.url.origin).toString(),
  site.brand.name,
  duplicateName,
);
---
<DocumentLayout page={page} socialImage={socialImage}>
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    {entry.detail ? (
      <ProductLanding bootstrap={entry.detail} imagePresentation={entry.product.imagePresentation} copy={getSharedDetailContent(DEFAULT_LOCALE)} canonicalPath={canonicalPath} catalogHref={catalogHref} heroImageApiOrigin={heroImageApiOrigin} client:load />
    ) : (
      <LegacySkuDetailPage initialProduct={entry.product} productId={entry.product._id} content={getCatalogContent(DEFAULT_LOCALE)} canonicalPath={canonicalPath} client:load />
    )}
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
  <AssistantHost />
</DocumentLayout>
