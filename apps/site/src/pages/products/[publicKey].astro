---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCatalogContent, getSharedDetailContent } from '../../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import { ProductLanding } from '../../islands/shop/ProductLanding.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productKey, productPath } from '../../lib/seo/product-identity.ts';
import { productPageDescriptor } from '../../lib/seo/product-page.ts';
import { readProductSnapshot, type ProductSnapshotEntry } from '../../lib/seo/product-snapshot.ts';

export async function getStaticPaths() {
  const snapshot = await readProductSnapshot(import.meta.env.SITE_URL || 'http://localhost:4321');
  const names = new Map<string, number>();
  for (const entry of snapshot.products) {
    const name = entry.detail?.name ?? entry.product.name;
    names.set(name, (names.get(name) ?? 0) + 1);
  }
  return snapshot.products.map((entry) => ({
    params: { publicKey: productKey(entry.product._id) },
    props: { entry, duplicateName: (names.get(entry.detail?.name ?? entry.product.name) ?? 0) > 1 },
  }));
}
interface Props { entry: ProductSnapshotEntry; duplicateName: boolean; }
const { entry, duplicateName } = Astro.props;
const site = getSiteContent(DEFAULT_LOCALE);
const content = getCatalogContent(DEFAULT_LOCALE);
const copy = getSharedDetailContent(DEFAULT_LOCALE);
const page = productPageDescriptor(entry, (Astro.site ?? Astro.url.origin).toString(), site.brand.name, duplicateName);
---
<BaseLayout page={page}>
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    <ProductLanding product={entry.product} bootstrap={entry.detail} content={content} copy={copy} canonicalPath={productPath(entry.product._id)} client:load />
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
</BaseLayout>
