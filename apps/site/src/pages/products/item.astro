---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCatalogContent } from '../../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../../i18n/site.ts';
import { SkuDetailPage } from '../../islands/shop/SkuDetailPage.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = getSiteContent(DEFAULT_LOCALE);
const catalog = getCatalogContent(DEFAULT_LOCALE);
const brand = site.brand;
const seoTitle = `Product Details | ${brand.name}`;
const seoDescription =
  'Review published product details, order quantities, available pricing, and related products for Channel OEM and wholesale programs.';
---

<BaseLayout title={seoTitle} description={seoDescription} canonicalPath="/products/item/">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    <SkuDetailPage content={catalog} client:load />
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
</BaseLayout>