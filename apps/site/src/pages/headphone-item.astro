---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHeadphonesContent } from '../i18n/headphones.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { ProductDetail } from '../islands/shop/ProductDetail.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = getSiteContent(DEFAULT_LOCALE);
const hp = getHeadphonesContent(DEFAULT_LOCALE);
const { brand, footer } = site;
const shopNav = { items: hp.shopNav };
---

<BaseLayout title={`${hp.meta.title} — ${brand.name}`} description={hp.meta.description} lang="en">
  <SiteHeader brand={brand} nav={shopNav} showName={false} />

  <main>
    <section class="py-10 sm:py-14">
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <ProductDetail content={hp} client:only="react" />
      </div>
    </section>
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
