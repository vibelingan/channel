---
import AIHero from '../components/AIHero.astro';
import CTASection from '../components/CTASection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import FactorySection from '../components/FactorySection.astro';
import OemProcessSection from '../components/OemProcessSection.astro';
import OurTeamSection from '../components/OurTeamSection.astro';
import QualityTestingSection from '../components/QualityTestingSection.astro';
import ServiceGridSection from '../components/ServiceGridSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WhyChooseUsSection from '../components/WhyChooseUsSection.astro';
import { getOemContent } from '../i18n/oem.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = getSiteContent(DEFAULT_LOCALE);
const { meta, submit, factoryVideo } = getOemContent(DEFAULT_LOCALE);
const {
  brand,
  nav,
  hero: siteHero,
  services,
  oemProcess,
  factory,
  ourPeople,
  whyChooseUs,
  quality,
  certifications,
  ctaSection,
  footer,
} = site;

// OEM-local hero reuses the homepage narrative; only the deep links point
// back into this page (the shared content object is never mutated).
const hero = {
  ...siteHero,
  primaryCta: { ...siteHero.primaryCta, href: '#submit' },
  secondaryCta: { ...siteHero.secondaryCta, href: '#factory' },
};

// /oem must carry its own checked-in factory video/poster pair — a silent
// fallback to the homepage media would erase the OEM-specific factory footage.
if (!factoryVideo) {
  throw new Error(
    'OEM content is missing factoryVideo. /oem requires the checked-in ' +
      '/media/oem-factory.mp4 + /media/factory-oem.webp pair (see content/oem/en-US.md).',
  );
}
const factoryMedia = { ...factoryVideo, label: factoryVideo.caption };
---

<BaseLayout title={`${meta.title} — ${brand.name}`} description={meta.description} lang="en">
  <SiteHeader brand={brand} nav={nav} />

  <main>
    <AIHero hero={hero} />
    <ServiceGridSection services={services} sectionId="what-we-do" />
    <OemProcessSection process={oemProcess} sectionId="process" />
    <FactorySection factory={factory} media={factoryMedia} />
    <OurTeamSection people={ourPeople} />
    <WhyChooseUsSection why={whyChooseUs} />
    <QualityTestingSection quality={quality} />
    <CertificationsSection certs={certifications} />
    <CTASection cta={ctaSection} submit={submit} sectionId="submit" />
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
