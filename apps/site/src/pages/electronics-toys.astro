---
import CatalogFamilyCard from '../components/CatalogFamilyCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCatalogContent } from '../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { FeaturedProducts } from '../islands/shop/FeaturedProducts.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { OEM_INQUIRY_HREF } from '../lib/site-navigation.ts';

const site = getSiteContent(DEFAULT_LOCALE);
const catalog = getCatalogContent(DEFAULT_LOCALE);
const brand = site.brand;
const seoTitle = `${catalog.hub.seoTitle} | ${brand.name}`;
const seoDescription = catalog.hub.seoDescription;
---

<BaseLayout title={seoTitle} description={seoDescription} canonicalPath="/electronics-toys/">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    <section class="border-b border-slate-200 bg-surface-alt">
      <div class="mx-auto grid max-w-[var(--width-container)] gap-8 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-brand-600">{catalog.hub.eyebrow}</p>
          <h1 class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl">{catalog.hub.heading}</h1>
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">{catalog.hub.body}</p>
        </div>
        <a
          href={OEM_INQUIRY_HREF}
          class="inline-flex min-h-11 items-center justify-center bg-accent-500 px-5 py-3 text-sm font-bold text-brand-950 transition hover:bg-accent-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
        >
          {catalog.hub.quoteLabel}
        </a>
      </div>
    </section>

    <section aria-label={catalog.hub.heading} class="bg-white">
      <div class="mx-auto max-w-[var(--width-container)] border-x border-slate-200">
        {catalog.families.map((family) => <CatalogFamilyCard family={family} />)}
      </div>
    </section>

    <section class="border-t border-slate-200 bg-surface-alt py-14 sm:py-18" aria-labelledby="featured-products-heading">
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-brand-600">{catalog.hub.catalogLabel}</p>
            <h2 id="featured-products-heading" class="mt-2 font-display text-3xl font-bold text-ink">
              {catalog.hub.featuredHeading}
            </h2>
          </div>
          <a href="/headphones/" class="min-h-11 py-3 text-sm font-semibold text-brand-700 underline-offset-4 hover:underline">
            {catalog.hub.browseLabel}
          </a>
        </div>
        <FeaturedProducts content={catalog} client:load />
      </div>
    </section>
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
</BaseLayout>
