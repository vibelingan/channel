---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHeadphonesContent } from '../i18n/headphones.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { AssistantWidget } from '../islands/ai/AssistantWidget.tsx';
import { HeadphonesPage } from '../islands/shop/HeadphonesPage.tsx';
import { ProductMedia } from '../islands/shop/ProductMedia.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiMediaUrl } from '../lib/api-url.ts';
import { OEM_INQUIRY_HREF } from '../lib/site-navigation.ts';

const site = getSiteContent(DEFAULT_LOCALE);
const hp = getHeadphonesContent(DEFAULT_LOCALE);
const { brand, nav, footer } = site;

// The reviewed hero provenance: three gated 800x800 product images, tried in
// order by ProductMedia. URLs stay behind the public image function — no
// copied static asset, no authorization relaxation.
const heroSources = hp.hero.sources.map((source) => apiMediaUrl(`/api/images/${source.imageId}`));

// SEO metadata
const seoTitle = `Headphones Manufacturer — OEM Bluetooth & Wired Headphone Supplier | ${brand.name}`;
const seoDescription =
  'Factory-direct headphone manufacturer in Dongguan, China. OEM/ODM over-ear headphones, TWS earbuds, kid-safe headphones. MOQ from 500 units, CE/FCC certified, global shipping. Request a quote today.';
---

<BaseLayout title={seoTitle} description={seoDescription} lang="en" canonicalPath="/headphones/">
  <SiteHeader brand={brand} nav={nav} />

  <main>
    <!-- ===== Hero: real gated product media, 55/45 unframed on desktop,
         media before the proof/CTA row on mobile ===== -->
    <section class="relative overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800 text-white">
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
        <div
          class="absolute inset-0"
          style="background-image: radial-gradient(circle at 25% 25%, #818cf8 1px, transparent 1px), radial-gradient(circle at 75% 75%, #818cf8 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div class="relative mx-auto max-w-[var(--width-container)] px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-[11fr_9fr] lg:items-center lg:gap-x-16 lg:[grid-template-areas:'copy_media'_'proof_media']"
        >
          <!-- Copy -->
          <div class="reveal min-w-0 lg:[grid-area:copy]">
            <p class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-300">
              {hp.hero.eyebrow}
            </p>
            <h1 class="mt-4 font-display text-[34px] font-bold leading-tight sm:text-5xl">
              {hp.hero.heading}
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
              {hp.hero.body}
            </p>
          </div>

          <!-- Real product media through the gated image function; ordered
               fallback + terminal branding handled by ProductMedia. -->
          <div class="reveal flex items-center justify-center lg:[grid-area:media]">
            <div
              data-hero-media
              class="relative aspect-square w-44 sm:w-72 lg:w-full lg:max-w-md"
            >
              <ProductMedia
                client:load
                sources={heroSources}
                alt={hp.hero.imageAlt}
                unavailableLabel={hp.hero.unavailableLabel}
                width={hp.hero.sources[0].width}
                height={hp.hero.sources[0].height}
                loading="eager"
                fetchPriority="high"
              />
            </div>
          </div>

          <!-- Compact proof + CTA row (after media on mobile) -->
          <div class="reveal min-w-0 lg:[grid-area:proof]">
            <div data-hero-proof class="flex flex-wrap gap-3">
              {hp.hero.proof.map((item) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-600/50 bg-brand-800/50 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur-sm">
                  <svg
                    class="h-4 w-4 text-accent-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </span>
              ))}
            </div>

            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="#headphones-inquiry"
                class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-base font-semibold text-brand-950 shadow-lg transition hover:bg-accent-400"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l9 6 9-6M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"
                  />
                </svg>
                {hp.hero.primaryCta}
              </a>
              <a
                href="#product-matrix"
                class="inline-flex items-center gap-2 rounded-lg border border-brand-500/40 bg-transparent px-7 py-3.5 text-base font-semibold text-white transition hover:bg-brand-700/50"
              >
                {hp.hero.secondaryCta}
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Product Matrix + Details (React island, SSR + hydrate) ===== -->
    <div id="product-matrix" class="scroll-mt-[var(--spacing-header)]">
      <noscript>
        <!-- The island server-renders its loading skeleton, which can never
             resolve without JavaScript. Hide it and state the real reason
             rather than claiming the catalog is empty. -->
        <style>#product-matrix .animate-pulse { display: none; }</style>
        <div class="mx-auto max-w-[var(--width-container)] px-4 py-10 sm:px-6 lg:px-8">
          <p class="rounded-lg border border-slate-200 bg-surface-alt p-6 text-center text-ink-muted">
            Browsing the model catalogue requires JavaScript. You can still reach us directly:
            <a class="ml-2 font-semibold text-brand-700 underline" href={OEM_INQUIRY_HREF}>
              {hp.list.emptyCtaLabel}
            </a>
          </p>
        </div>
      </noscript>
      <HeadphonesPage content={hp} client:load />
    </div>

  </main>

  <SiteFooter brand={brand} footer={footer} />
  <AssistantWidget client:load />
</BaseLayout>
