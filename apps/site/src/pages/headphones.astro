---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHeadphonesContent } from '../i18n/headphones.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { ProductGrid } from '../islands/shop/ProductGrid.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = getSiteContent(DEFAULT_LOCALE);
const hp = getHeadphonesContent(DEFAULT_LOCALE);
const { brand, footer } = site;
const shopNav = { items: hp.shopNav };
const config = {
  apiPath: '/api/products',
  detailPath: '/headphone-item',
  fallbackImage: '/api/images/_placeholder',
};
---

<BaseLayout title={`${hp.meta.title} — ${brand.name}`} description={hp.meta.description} lang="en">
  <SiteHeader brand={brand} nav={shopNav} showName={false} />

  <main>
    <!-- Catalog header -->
    <section class="border-b border-slate-200 bg-surface-alt">
      <div class="mx-auto max-w-[var(--width-container)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
          {hp.list.eyebrow}
        </p>
        <h1 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">
          {hp.list.heading}
        </h1>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-soft">
          {hp.list.subheading}
        </p>
      </div>
    </section>

    <!-- Catalog grid (React island) -->
    <section class="py-10 sm:py-12">
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <ProductGrid content={hp.list} config={config} client:only="react" />
      </div>
    </section>
  </main>

  <SiteFooter brand={brand} footer={footer} />
</BaseLayout>
