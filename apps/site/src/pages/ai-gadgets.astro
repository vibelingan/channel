---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCatalogContent, getCatalogFamily } from '../i18n/catalog.ts';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import { CatalogFamilyPage } from '../islands/shop/CatalogFamilyPage.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalogBreadcrumbSchema, familyBreadcrumbs } from '../lib/catalog-seo.ts';
import { OEM_INQUIRY_HREF } from '../lib/site-navigation.ts';

const site = getSiteContent(DEFAULT_LOCALE);
const catalog = getCatalogContent(DEFAULT_LOCALE);
const family = getCatalogFamily('ai-gadgets', DEFAULT_LOCALE);
const brand = site.brand;
const seoTitle = `${family.seoTitle} | ${brand.name}`;
const seoDescription = family.seoDescription;
const breadcrumbs = familyBreadcrumbs(family.heading, family.href);
const schemaNodes = [catalogBreadcrumbSchema(breadcrumbs, Astro.site ?? Astro.url.origin)];
---

<BaseLayout title={seoTitle} description={seoDescription} canonicalPath="/ai-gadgets/" schemaNodes={schemaNodes}>
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    <section class="border-b border-slate-200 bg-surface-alt">
      <div class="mx-auto max-w-[var(--width-container)] px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
          {breadcrumbs.map((breadcrumb, index) => (
            index < breadcrumbs.length - 1 ? (
              <><a href={breadcrumb.href} class="hover:text-brand-700">{breadcrumb.label}</a><span class="px-2" aria-hidden="true">/</span></>
            ) : <span aria-current="page">{breadcrumb.label}</span>
          ))}
        </nav>
        <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-brand-600">{family.eyebrow}</p>
            <h1
              data-catalog-heading
              class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl"
            >
              {family.heading}
            </h1>
            <p class="mt-4 text-lg leading-relaxed text-ink-soft">{family.description}</p>
          </div>
          <a
            href={OEM_INQUIRY_HREF}
            class="inline-flex min-h-11 items-center justify-center bg-accent-500 px-5 py-3 text-sm font-bold text-brand-950 hover:bg-accent-400"
          >
            {catalog.hub.quoteLabel}
          </a>
        </div>
      </div>
    </section>
    <section class="bg-white py-10 sm:py-14" aria-label={family.heading}>
      <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
        <CatalogFamilyPage content={catalog} family={family} client:load />
      </div>
    </section>
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
</BaseLayout>