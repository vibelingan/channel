---
import type { OemContent } from '../i18n/oem.ts';
import type { SiteContent } from '../i18n/site.ts';
/**
 * Final CTA section — direct OEM inquiry form.
 */
import ProjectForm from './ProjectForm.astro';

interface Props {
  cta: SiteContent['ctaSection'];
  submit: OemContent['submit'];
}

const { cta, submit } = Astro.props;
---

<section
  id="oem-inquiry"
  aria-labelledby="oem-inquiry-heading"
  class="relative scroll-mt-[var(--spacing-header)] overflow-hidden bg-surface-dark text-white"
>
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(99,102,241,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(99,102,241,0.5) 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-[var(--width-container)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-300">
        {submit.eyebrow}
      </p>
      <h2 id="oem-inquiry-heading" class="mt-4 font-display text-3xl font-bold sm:text-4xl">
        {cta.heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">
        {cta.description}
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-4xl sm:mt-16">
      <ProjectForm
        fields={submit.fields}
        submitLabel={submit.submitLabel}
        disclaimer={submit.disclaimer}
        successTitle={submit.successTitle}
        successBody={submit.successBody}
        action="/api/admin"
        resultPath="/oem_submit_result"
      />
    </div>
  </div>
</section>
