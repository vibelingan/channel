---
/**
 * ProductConceptCard — listing-page card for a single Blue Ocean concept product.
 *
 * Surfaces the product name, tagline, category badge, and headline economics
 * (MSRP, est. BOM cost, est. margin), linking through to the full
 * `/blue-ocean/[slug]` detail page.
 */
import type { BlueOceanProduct } from '../data/blueOceanProducts.ts';

interface Props {
  product: BlueOceanProduct;
}

const { product } = Astro.props;

const currency = (value: number) =>
  `$${value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
const margin = ((product.msrp - product.estBomCost) / product.msrp) * 100;
---

<a
  href={`/blue-ocean/${product.slug}`}
  class="reveal group flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-slate-200 bg-surface shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg"
>
  <!-- Category badge -->
  <div class="border-b border-slate-100 px-6 py-4">
    <span
      class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 2.25c5.385 0 9.75 4.365 9.75 9.75s-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12 6.615 2.25 12 2.25Zm0 0a8.25 8.25 0 0 0-3.75 7.5c0 2.9 1.5 5.25 3.75 7.5m0-15a8.25 8.25 0 0 1 3.75 7.5c0 2.9-1.5 5.25-3.75 7.5m-9-7.5h18"
        ></path>
      </svg>
      {product.category}
    </span>
  </div>

  <!-- Product name + tagline -->
  <div class="flex flex-1 flex-col px-6 py-5">
    <h3 class="font-display text-xl font-bold text-ink transition group-hover:text-brand-700">
      {product.name}
    </h3>
    <p class="mt-2 text-sm font-medium text-brand-600">{product.tagline}</p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">
      {product.summary}
    </p>

    <!-- Economics grid -->
    <dl class="mt-6 grid grid-cols-3 gap-3 border-t border-slate-100 pt-5">
      <div>
        <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">MSRP</dt>
        <dd class="mt-1 font-display text-lg font-bold text-ink">
          {currency(product.msrp)}
        </dd>
      </div>
      <div>
        <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Est. BOM</dt>
        <dd class="mt-1 font-display text-lg font-bold text-ink-soft">
          {currency(product.estBomCost)}
        </dd>
      </div>
      <div>
        <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">Margin</dt>
        <dd class="mt-1 font-display text-lg font-bold text-accent-600">
          {margin.toFixed(1)}%
        </dd>
      </div>
    </dl>

    <!-- Explore CTA -->
    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition group-hover:gap-2.5 group-hover:text-brand-700"
    >
      Explore concept
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </div>
</a>
