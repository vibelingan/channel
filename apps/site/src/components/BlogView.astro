---
import type { ArticlePageData } from '@vibelingan-channel/articles/build';
import type { ArticleSummary } from '@vibelingan-channel/articles/public-read';
import PageHero from '../components/PageHero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DEFAULT_LOCALE, getSiteContent } from '../i18n/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  articleBody,
  articleDate,
  articlePage,
  articlePath,
  articleSummary,
  blogCopy,
  blogPage,
  dummyBlogLocation,
  publicBlogLocation,
} from '../lib/blog/page.ts';
import BlogRuntimeFreshness from './BlogRuntimeFreshness.astro';

interface Props {
  articles: (ArticlePageData | ArticleSummary)[];
  article: ArticlePageData | null;
  dummy?: boolean;
  server?: boolean;
  next?: string | null;
  cursor?: string;
}
const { articles, article, dummy = false, server = false, next = null, cursor } = Astro.props;
const location = dummy
  ? dummyBlogLocation
  : server
    ? { ...publicBlogLocation, mediaPrefix: '/blog' }
    : publicBlogLocation;
const site = getSiteContent(DEFAULT_LOCALE);
const origin = (Astro.site ?? Astro.url.origin).toString();
const basePage = article
  ? articlePage(article, origin, site.brand.name, location)
  : blogPage(articles, origin, site.brand.name, location);
const page = cursor
  ? {
      ...basePage,
      path: `/blog/page/${encodeURIComponent(cursor)}/`,
      canonicalPath: `/blog/page/${encodeURIComponent(cursor)}/`,
    }
  : basePage;
---
<BaseLayout page={page} lang="en">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main>
    {article ? (
      <article class="mx-auto max-w-3xl px-4 pb-20 pt-10 sm:px-6 sm:pt-14 lg:px-8" data-blog-article>
        <nav aria-label="Breadcrumb" class="mb-8 text-sm text-ink-muted">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a href="/" class="hover:text-brand-700 hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={location.root} class="hover:text-brand-700 hover:underline">{blogCopy.title}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="break-words">{article.content.title}</li>
          </ol>
        </nav>
        <header class="mb-10 border-b border-slate-200 pb-8">
          <h1 class="break-words font-display text-3xl font-bold leading-tight text-ink sm:text-4xl">{article.content.title}</h1>
          {article.content.excerpt && <p class="mt-5 text-lg leading-relaxed text-ink-soft">{article.content.excerpt}</p>}
          <p class="mt-5 text-sm text-ink-muted">
            <span>By {article.content.authorName}</span>
            <span class="mx-2" aria-hidden="true">·</span>
            <time datetime={article.publishedAt}>{articleDate(article.publishedAt)}</time>
          </p>
          {article.modifiedAt !== article.publishedAt && <p class="mt-2 text-sm text-ink-muted">Updated <time datetime={article.modifiedAt}>{articleDate(article.modifiedAt)}</time></p>}
        </header>
        <div class="article-body" set:html={articleBody(article, location)} />
        <a href={location.root} class="mt-12 inline-flex min-h-11 items-center font-semibold text-brand-700 underline underline-offset-4">All insights</a>
      </article>
    ) : (
      <>
        <PageHero eyebrow="Knowledge & resources" heading={blogCopy.title} subheading={blogCopy.description} />
        <section aria-label="Articles" class="mx-auto max-w-[var(--width-container)] px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
          {!articles.length && <p class="text-ink-muted">No published articles.</p>}
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((item) => (
              <article class="flex flex-col rounded-[var(--radius-card)] border border-slate-200 bg-surface p-6 shadow-[var(--shadow-card)]">
                <p class="text-sm text-ink-muted"><time datetime={item.publishedAt}>{articleDate(item.publishedAt)}</time></p>
                <h2 class="mt-3 break-words font-display text-xl font-semibold leading-snug"><a href={articlePath(item, location)} class="text-ink hover:text-brand-700 hover:underline focus-visible:outline-2 focus-visible:outline-brand-700">{item.content.title}</a></h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{articleSummary(item)}</p>
                <p class="mt-5 text-sm text-ink-muted">{item.content.authorName}</p>
              </article>
            ))}
          </div>
          {(next || cursor) && <nav aria-label="Article pages" class="mt-8 flex gap-6">
            {cursor && <a href="/blog/" class="font-semibold text-brand-700 underline">Latest insights</a>}
            {next && <a href={`/blog/page/${encodeURIComponent(next)}/`} class="font-semibold text-brand-700 underline">More insights</a>}
          </nav>}
        </section>
      </>
    )}
  </main>
  <SiteFooter brand={site.brand} footer={site.footer} />
  {server && <BlogRuntimeFreshness />}
</BaseLayout>
