---
import type { SiteContent } from '../i18n/site.ts';

interface Props {
  hero: SiteContent['hero'];
  videoSrc?: string;
  posterSrc?: string;
}

const {
  hero,
  videoSrc = '/media/videoanimation.mp4',
  posterSrc = '/media/videoanimation.webp',
} = Astro.props;
---

<section
  class="relative flex min-h-[100svh] items-center overflow-hidden bg-surface-dark"
  aria-label="Introduction"
>
  <!-- Background video with webp poster shown while the video downloads -->
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={posterSrc}
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={videoSrc} type="video/mp4" />
    <!-- Fallback image for browsers that can't play the video -->
    <img src={posterSrc} alt="" class="h-full w-full object-cover" />
  </video>

  <!-- Readability overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-brand-950/80 via-brand-950/55 to-brand-950/85"
    aria-hidden="true"
  >
  </div>

  <!-- Hero content -->
  <div
    class="relative mx-auto w-full max-w-[var(--width-container)] px-4 py-24 text-white sm:px-6 lg:px-8"
  >
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent-300">
        {hero.eyebrow}
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        {hero.heading}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
        {hero.subheading}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={hero.primaryCta.href}
          class="inline-flex items-center justify-center rounded-lg bg-accent-500 px-6 py-3 text-base font-semibold text-brand-950 shadow-lg transition hover:bg-accent-400"
        >
          {hero.primaryCta.label}
        </a>
        <a
          href={hero.secondaryCta.href}
          class="inline-flex items-center justify-center rounded-lg border border-white/40 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <a
    href="#heritage"
    class="absolute inset-x-0 bottom-6 mx-auto flex w-fit flex-col items-center gap-1 text-xs font-medium uppercase tracking-widest text-white/70 transition hover:text-white"
  >
    <span>{hero.scrollLabel}</span>
    <svg class="h-5 w-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>
