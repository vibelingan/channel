---
/**
 * Teardown Lab teaser section — dark themed with stats.
 */
import type { SiteContent } from '../i18n/site.ts';
import type { StatItem } from '../i18n/site.ts';

interface Props {
  teaser: SiteContent['teardownTeaser'];
}

const { teaser } = Astro.props;
---

<section class="relative overflow-hidden bg-surface-dark text-white">
  <!-- Background glow -->
  <div class="pointer-events-none absolute right-0 top-0 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[var(--width-container)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-300">
          {teaser.eyebrow}
        </p>
        <h2 class="mt-4 font-display text-3xl font-bold sm:text-4xl">
          {teaser.heading}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-300">
          {teaser.description}
        </p>
        <a
          href={teaser.cta.href}
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-base font-semibold text-white backdrop-blur transition hover:bg-white/20"
        >
          {teaser.cta.label}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="reveal grid grid-cols-3 gap-4">
        {teaser.stats.map((stat: StatItem) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur">
            <div class="font-display text-3xl font-bold text-brand-300">
              {stat.value}
            </div>
            <div class="mt-2 text-xs font-medium uppercase tracking-wider text-slate-400">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
