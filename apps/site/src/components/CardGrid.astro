---
/**
 * CardGrid — responsive grid of icon cards.
 *
 * Data-driven from an array of { icon, title, desc }. Reused for the OEM
 * service capabilities and the development-capability families.
 */
import type { IconCard } from '../i18n/oem.ts';
import Icon from './Icon.astro';

interface Props {
  items: IconCard[];
  /** Cards per row at the large breakpoint. */
  columns?: 3 | 4;
}

const { items, columns = 4 } = Astro.props;

const colClass = columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<ul class:list={['grid grid-cols-1 gap-5', colClass]}>
  {
    items.map((item) => (
      <li class="reveal group h-full rounded-[var(--radius-card)] border border-slate-200 bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
          <Icon name={item.icon} class="h-6 w-6" />
        </span>
        <h3 class="mt-5 font-display text-lg font-semibold text-ink">{item.title}</h3>
        {item.desc && <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.desc}</p>}
      </li>
    ))
  }
</ul>
