---
/**
 * Blue Ocean Products teaser — light section with product cards.
 */
import type { SiteContent } from '../i18n/site.ts';
import type { ProductTeaserItem } from '../i18n/site.ts';

interface Props {
  teaser: SiteContent['blueOceanTeaser'];
}

const { teaser } = Astro.props;
---

<section class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
        {teaser.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">
        {teaser.heading}
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {teaser.description}
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {teaser.products.map((product: ProductTeaserItem, i: number) => (
        <a
          href={teaser.cta.href}
          class="reveal group relative overflow-hidden rounded-[var(--radius-card)] border border-black/5 bg-gradient-to-br from-surface to-surface-alt p-8 shadow-[var(--shadow-card)] transition hover:-translate-y-1 hover:shadow-lg"
          style={`transition-delay: ${i * 100}ms`}
        >
          <div class="absolute right-4 top-4 rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-600">
            {product.msrp}
          </div>
          <h3 class="pr-16 font-display text-xl font-bold text-ink">
            {product.name}
          </h3>
          <p class="mt-2 text-sm text-ink-soft">
            {product.tagline}
          </p>
          <div class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition group-hover:gap-2">
            Learn more
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href={teaser.cta.href}
        class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg transition hover:bg-brand-700"
      >
        {teaser.cta.label}
      </a>
    </div>
  </div>
</section>
