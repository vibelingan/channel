---
/**
 * Icon — a single source of consistent line icons used across the site.
 *
 * Usage: <Icon name="design" class="h-6 w-6" />
 * All icons share a 24×24 viewBox and inherit `currentColor`, so size and color
 * come from utility classes / tokens at the call site.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

// Each entry is the inner markup of a 24×24, currentColor stroke icon.
const ICONS: Record<string, string> = {
  design: '<path d="M4 20l1-4L16 5a2 2 0 0 1 3 3L8 19l-4 1z"/><path d="M13.5 6.5l3 3"/>',
  'id-design':
    '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/>',
  mold: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  engineer:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5 5l2.2 2.2M16.8 16.8L19 19M19 5l-2.2 2.2M7.2 16.8L5 19"/>',
  sampling:
    '<path d="M9 3h6M10 3v5.5L5.5 17a2 2 0 0 0 1.8 3h9.4a2 2 0 0 0 1.8-3L14 8.5V3"/><path d="M7.5 14h9"/>',
  production: '<path d="M3 21V10l6 4V10l6 4V7l6 3v11H3z"/><path d="M7 21v-3M12 21v-3M17 21v-3"/>',
  quality: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  logistics:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.5 2.6 15.5 0 18M12 3c-2.6 2.5-2.6 15.5 0 18"/>',
  plastic: '<path d="M12 3c4 5 6 8.2 6 11a6 6 0 0 1-12 0c0-2.8 2-6 6-11z"/>',
  electronics:
    '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 2.5v3M14 2.5v3M10 18.5v3M14 18.5v3M2.5 10h3M2.5 14h3M18.5 10h3M18.5 14h3"/>',
  headphones:
    '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="7" rx="1.4"/><rect x="17" y="13" width="4" height="7" rx="1.4"/>',
  consumer: '<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8a3 3 0 0 1 6 0"/>',
  hardware: '<path d="M9 4h6l4 4v6l-4 4H9l-4-4V8l4-4z"/><circle cx="12" cy="11" r="2.6"/>',
  promotional:
    '<rect x="4" y="9" width="16" height="11" rx="1.2"/><path d="M4 13h16M12 9v11"/><path d="M12 9C9.5 9 8 8 8 6.4A2.2 2.2 0 0 1 12 5a2.2 2.2 0 0 1 4 1.4C16 8 14.5 9 12 9z"/>',
  experience: '<circle cx="12" cy="9" r="5"/><path d="M8.5 13.2L7 21l5-3 5 3-1.5-7.8"/>',
  partners:
    '<circle cx="9" cy="9" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><path d="M16 6.3a3 3 0 0 1 0 5.7M20.5 19.5a5.5 5.5 0 0 0-4.2-5.3"/>',
  moq: '<path d="M4 8h9M19 8h1M4 16h1M11 16h9"/><circle cx="16" cy="8" r="2.3"/><circle cx="8" cy="16" r="2.3"/>',
  compliance: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-5"/>',
  manager:
    '<circle cx="10" cy="8" r="3.5"/><path d="M3.8 20a6.2 6.2 0 0 1 12.4 0"/><path d="M16 12.5l2 2 4-4"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
};

const inner = ICONS[name] ?? ICONS.design;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
>
</svg>
