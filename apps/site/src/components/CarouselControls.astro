---
interface Props {
  trackId: string;
  itemCount: number;
}

const { trackId, itemCount } = Astro.props;
---

<div
  class:list={[
    'mt-5 flex items-center justify-between gap-4 lg:hidden',
    itemCount <= 1 && 'hidden',
  ]}
  data-carousel-controls
>
  <span class="min-w-14 text-sm font-medium tabular-nums text-ink-soft" data-carousel-position>
    1 / {itemCount}
  </span>
  <div class="flex items-center gap-2">
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-ink shadow-sm outline-none transition hover:border-brand-500 hover:text-brand-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-45"
      aria-label="Previous slide"
      aria-controls={trackId}
      data-carousel-previous
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-ink shadow-sm outline-none transition hover:border-brand-500 hover:text-brand-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-45"
      aria-label="Pause automatic rotation"
      aria-controls={trackId}
      data-carousel-toggle
    >
      <span data-carousel-pause-icon>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M7 5h3v14H7zM14 5h3v14h-3z"></path>
        </svg>
      </span>
      <span class="hidden" data-carousel-play-icon>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="m8 5 11 7-11 7z"></path>
        </svg>
      </span>
    </button>
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-ink shadow-sm outline-none transition hover:border-brand-500 hover:text-brand-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-45"
      aria-label="Next slide"
      aria-controls={trackId}
      data-carousel-next
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const AUTOPLAY_INTERVAL_MS = 5_000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    if (root.dataset.carouselReady === 'true') continue;
    root.dataset.carouselReady = 'true';

    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const previous = root.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
    const pauseIcon = root.querySelector<HTMLElement>('[data-carousel-pause-icon]');
    const playIcon = root.querySelector<HTMLElement>('[data-carousel-play-icon]');
    const position = root.querySelector<HTMLElement>('[data-carousel-position]');
    if (!track || slides.length === 0 || !previous || !next || !toggle) continue;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1024px)');
    let currentIndex = 0;
    let rotationTimer: number | undefined;
    let manuallyPaused = false;
    let inViewport = true;
    let scrollFrame: number | undefined;

    const updatePosition = () => {
      if (position) position.textContent = `${currentIndex + 1} / ${slides.length}`;
    };

    const updateToggle = () => {
      const isRotating = rotationTimer !== undefined;
      pauseIcon?.classList.toggle('hidden', !isRotating);
      playIcon?.classList.toggle('hidden', isRotating);
      toggle.disabled = reducedMotion.matches;
      toggle.setAttribute(
        'aria-label',
        reducedMotion.matches
          ? 'Automatic rotation disabled by reduced motion preference'
          : isRotating
            ? 'Pause automatic rotation'
            : 'Resume automatic rotation',
      );
    };

    const stopRotation = (manual = false) => {
      if (rotationTimer !== undefined) window.clearInterval(rotationTimer);
      rotationTimer = undefined;
      if (manual) manuallyPaused = true;
      updateToggle();
    };

    const moveTo = (index: number) => {
      currentIndex = (index + slides.length) % slides.length;
      const slide = slides[currentIndex];
      const trackRect = track.getBoundingClientRect();
      const slideRect = slide.getBoundingClientRect();
      track.scrollTo({
        left: track.scrollLeft + slideRect.left - trackRect.left,
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
      updatePosition();
    };

    const startRotation = () => {
      stopRotation();
      if (
        manuallyPaused ||
        reducedMotion.matches ||
        desktop.matches ||
        !inViewport ||
        document.hidden ||
        slides.length <= 1
      ) {
        updateToggle();
        return;
      }
      rotationTimer = window.setInterval(() => moveTo(currentIndex + 1), AUTOPLAY_INTERVAL_MS);
      updateToggle();
    };

    const pauseForUser = () => stopRotation(true);
    const moveForUser = (index: number) => {
      pauseForUser();
      moveTo(index);
    };

    previous.addEventListener('click', () => moveForUser(currentIndex - 1));
    next.addEventListener('click', () => moveForUser(currentIndex + 1));
    toggle.addEventListener('click', () => {
      if (rotationTimer !== undefined) {
        pauseForUser();
      } else {
        manuallyPaused = false;
        startRotation();
      }
    });

    root.addEventListener('focusin', (event) => {
      if (!(event.target as Element).closest('[data-carousel-toggle]')) pauseForUser();
    });
    root.addEventListener('pointerdown', (event) => {
      if (!(event.target as Element).closest('[data-carousel-toggle]')) pauseForUser();
    });
    root.addEventListener('wheel', pauseForUser, { passive: true });
    root.addEventListener('keydown', (event) => {
      if ((event.target as Element).closest('dialog')) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        moveForUser(currentIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        moveForUser(currentIndex + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        moveForUser(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        moveForUser(slides.length - 1);
      }
    });

    track.addEventListener(
      'scroll',
      () => {
        if (scrollFrame !== undefined) window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(() => {
          const trackLeft = track.getBoundingClientRect().left;
          currentIndex = slides.reduce(
            (closestIndex, slide, index) =>
              Math.abs(slide.getBoundingClientRect().left - trackLeft) <
              Math.abs(slides[closestIndex].getBoundingClientRect().left - trackLeft)
                ? index
                : closestIndex,
            0,
          );
          updatePosition();
        });
      },
      { passive: true },
    );

    const refreshMotion = () => {
      if (reducedMotion.matches || desktop.matches) stopRotation();
      else startRotation();
    };
    reducedMotion.addEventListener('change', refreshMotion);
    desktop.addEventListener('change', refreshMotion);
    document.addEventListener('visibilitychange', refreshMotion);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          if (inViewport) startRotation();
          else stopRotation();
        },
        { threshold: 0.2 },
      );
      observer.observe(root);
    }

    updatePosition();
    startRotation();
  }
</script>