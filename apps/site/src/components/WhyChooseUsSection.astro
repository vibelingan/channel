---
/**
 * Why Choose Us — 3 reasons with icons.
 */
import type { SiteContent } from '../i18n/site.ts';
import type { ReasonItem } from '../i18n/site.ts';

interface Props {
  why: SiteContent['whyChooseUs'];
}

const { why } = Astro.props;

const iconPaths: Record<string, string> = {
  scale: 'M3 6l6 6-6 6m18-12l-6 6 6 6M12 3v18',
  certificate:
    'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'user-check': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section class="bg-surface-alt py-20 sm:py-28">
  <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
        {why.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">
        {why.heading}
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {why.intro}
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {why.reasons.map((reason: ReasonItem, i: number) => (
        <div
          class="reveal group rounded-[var(--radius-card)] border border-slate-200 bg-surface p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-[var(--shadow-card)]"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[reason.icon] || iconPaths['scale']} />
            </svg>
          </div>
          <h3 class="font-display text-lg font-semibold text-ink">
            {reason.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            {reason.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
