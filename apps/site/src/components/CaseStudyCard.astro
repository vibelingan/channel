---
/**
 * CaseStudyCard — full-content card for a single Success Stories case study.
 *
 * Surfaces the title, client, category badge, summary, capability chips, and
 * headline metrics, plus an expandable STAR breakdown (Situation, Task, Action,
 * Result) using a native `<details>` element for accessible progressive
 * disclosure with no client-side JavaScript required.
 */
import type { CaseStudy } from '../data/successStories.ts';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

const star = [
  { key: 'Situation', label: 'Situation', text: study.situation },
  { key: 'Task', label: 'Task', text: study.task },
  { key: 'Action', label: 'Action', text: study.action },
  { key: 'Result', label: 'Result', text: study.result },
] as const;
---

<article
  class="reveal flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-slate-200 bg-surface shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg"
>
  <!-- Category badge -->
  <div class="border-b border-slate-100 px-6 py-4">
    <span
      class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
        ></path>
      </svg>
      {study.category}
    </span>
  </div>

  <!-- Title + client + summary -->
  <div class="flex flex-1 flex-col px-6 py-5">
    <h3 class="font-display text-xl font-bold text-ink">
      {study.title}
    </h3>
    <p class="mt-1.5 text-sm font-medium text-brand-600">{study.client}</p>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      {study.summary}
    </p>

    <!-- Capability chips -->
    <ul class="mt-4 flex flex-wrap gap-2">
      {study.capabilities.map((capability) => (
        <li class="rounded-md border border-slate-200 bg-surface-alt px-2.5 py-1 text-xs font-medium text-ink-soft">
          {capability}
        </li>
      ))}
    </ul>

    <!-- Metrics grid -->
    <dl class="mt-6 grid grid-cols-1 gap-3 border-t border-slate-100 pt-5 sm:grid-cols-3">
      {study.metrics.map((metric) => (
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">{metric.label}</dt>
          <dd class="mt-1 text-sm font-semibold text-ink">{metric.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Expandable STAR details -->
    <details class="group mt-5 border-t border-slate-100 pt-5">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-2 text-sm font-semibold text-brand-600 transition group-hover:text-brand-700"
      >
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
          </svg>
          View full case details
        </span>
        <svg
          class="h-4 w-4 shrink-0 text-ink-muted transition duration-300 group-open:rotate-180"
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </summary>

      <dl class="mt-5 space-y-5">
        {star.map((item) => (
          <div class="relative pl-5">
            <span class="absolute left-0 top-1.5 h-[calc(100%-0.375rem)] w-0.5 rounded-full bg-brand-200"></span>
            <dt class="text-xs font-semibold uppercase tracking-wider text-brand-600">{item.label}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.text}</dd>
          </div>
        ))}
      </dl>
    </details>
  </div>
</article>
