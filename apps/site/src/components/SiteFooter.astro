---
import type { SiteContent } from '../i18n/site.ts';

interface Props {
  brand: SiteContent['brand'];
  footer: SiteContent['footer'];
}

const { brand, footer } = Astro.props;
---

<footer class="bg-surface-dark text-white">
  <div class="mx-auto max-w-[var(--width-container)] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
      <!-- Brand blurb -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/favicon.svg"
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 shrink-0 rounded-lg"
            aria-hidden="true"
          />
          <span class="font-display text-base font-semibold">{brand.name}</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/65">
          {footer.blurb}
        </p>
        <p
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-accent-500/15 px-3 py-1 text-xs font-semibold text-accent-300"
        >
          {brand.minOrder}
        </p>
      </div>

      <!-- Link columns -->
      {
        footer.columns.map((column) => (
          <div>
            <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white/90">
              {column.heading}
            </h3>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-white/65 transition hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Legal bar -->
    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-white/55 sm:flex-row"
    >
      <p>{footer.legal}</p>
      <p class="text-white/45">{brand.tagline}</p>
    </div>
  </div>
</footer>
