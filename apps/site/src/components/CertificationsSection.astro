---
/**
 * Certifications & Global Clients — compliance certs + client logo wall
 * (PPTX P8). Uses real client-supplied certificate scans and brand logos.
 */
import type { SiteContent } from '../i18n/site.ts';

interface Props {
  certs: SiteContent['certifications'];
}

const { certs } = Astro.props;

// Real compliance certificate scans (client-supplied).
const complianceCerts = [
  {
    name: 'CE',
    img: '/media/oem/certs/ce.jpg',
    description: 'European conformity',
    width: 706,
    height: 1000,
  },
  {
    name: 'EMC',
    img: '/media/oem/certs/emc.jpg',
    description: 'Electromagnetic compatibility',
    width: 707,
    height: 1000,
  },
  {
    name: 'FCC',
    img: '/media/oem/certs/fcc.jpg',
    description: 'U.S. FCC compliance',
    width: 706,
    height: 1000,
  },
  {
    name: 'JD',
    img: '/media/oem/certs/jd.jpg',
    description: 'Retail channel quality',
    width: 772,
    height: 1000,
  },
];

// Real client brand logos.
const clientLogos = [
  { name: 'Artcoustic', img: '/media/oem/clients/artcoustic.png', width: 400, height: 65 },
  {
    name: 'Audio Diversity',
    img: '/media/oem/clients/audio-diversity.png',
    width: 400,
    height: 124,
  },
  { name: 'CoreMee', img: '/media/oem/clients/coremee.png', width: 400, height: 87 },
  { name: 'DI', img: '/media/oem/clients/di.png', width: 400, height: 120 },
  { name: 'pabobo', img: '/media/oem/clients/pabobo.jpg', width: 400, height: 400 },
  { name: 'AS', img: '/media/oem/clients/as.png', width: 400, height: 400 },
];
---

<section class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
        {certs.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">
        {certs.heading}
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {certs.intro}
      </p>
    </div>

    <!-- Compliance Certifications -->
    <div class="reveal mt-14">
      <h3 class="text-center font-display text-lg font-semibold text-ink">
        Company &amp; Compliance
      </h3>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {complianceCerts.map((cert) => (
          <figure class="flex flex-col items-center rounded-[var(--radius-card)] border border-slate-200 bg-surface-alt p-4 text-center shadow-sm">
            <img
              src={cert.img}
              alt={`${cert.name} certification`}
              width={cert.width}
              height={cert.height}
              loading="lazy"
              class="h-40 w-full rounded-md bg-white object-contain ring-1 ring-black/5"
            />
            <figcaption class="mt-3">
              <p class="font-display text-sm font-semibold text-ink">{cert.name}</p>
              <p class="mt-0.5 text-xs text-ink-muted">{cert.description}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Global Clients -->
    <div class="reveal mt-16">
      <h3 class="text-center font-display text-lg font-semibold text-ink">
        Global Clients
      </h3>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {clientLogos.map((client) => (
          <div class="flex h-24 items-center justify-center rounded-[var(--radius-card)] border border-slate-200 bg-surface-alt px-4 py-6 shadow-sm">
            <img
              src={client.img}
              alt={`${client.name} logo`}
              width={client.width}
              height={client.height}
              loading="lazy"
              class="max-h-12 w-auto max-w-full object-contain opacity-80 transition hover:opacity-100"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
