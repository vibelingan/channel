---
/**
 * Certifications & Global Clients — compliance certs + client logo wall.
 */
import type { SiteContent } from '../i18n/site.ts';
import type { CertItem } from '../i18n/site.ts';

interface Props {
  certs: SiteContent['certifications'];
}

const { certs } = Astro.props;
---

<section class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
        {certs.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">
        {certs.heading}
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {certs.intro}
      </p>
    </div>

    <!-- Compliance Certifications -->
    <div class="reveal mt-14">
      <h3 class="text-center font-display text-lg font-semibold text-ink">
        Company &amp; Compliance
      </h3>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {certs.complianceCerts.map((cert: CertItem) => (
          <div class="flex flex-col items-center rounded-[var(--radius-card)] border border-slate-200 bg-surface-alt p-6 text-center shadow-sm">
            <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <p class="font-display text-sm font-semibold text-ink">{cert.name}</p>
            <p class="mt-1 text-xs text-ink-muted">{cert.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Global Clients -->
    <div class="reveal mt-16">
      <h3 class="text-center font-display text-lg font-semibold text-ink">
        Global Clients
      </h3>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {certs.clientLogos.map((client: string) => (
          <div class="flex items-center justify-center rounded-[var(--radius-card)] border border-slate-200 bg-surface-alt px-4 py-6 shadow-sm">
            <span class="font-display text-sm font-semibold text-ink-muted">{client}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
