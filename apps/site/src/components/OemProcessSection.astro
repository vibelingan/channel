---
/**
 * OEM Development Process — 10-step workflow chain.
 * Uses the existing WorkflowChain component pattern.
 */
import type { SiteContent } from '../i18n/site.ts';
import type { WorkflowStepItem } from '../i18n/site.ts';

interface Props {
  process: SiteContent['oemProcess'];
}

const { process } = Astro.props;
---

<section class="bg-surface-alt py-20 sm:py-28">
  <div class="mx-auto max-w-[var(--width-container)] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600">
        {process.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink sm:text-4xl">
        {process.heading}
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {process.intro}
      </p>
    </div>

    <div class="mt-16">
      <ol class="relative flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-0">
        {process.steps.map((step: WorkflowStepItem, index: number) => (
          <li class="reveal relative flex flex-1 items-start gap-4 lg:flex-col lg:items-center lg:text-center">
            {index < process.steps.length - 1 && (
              <span
                class="absolute left-5 top-12 h-[calc(100%+1.5rem)] w-px bg-brand-200 lg:left-auto lg:top-5 lg:h-px lg:w-full lg:translate-x-1/2"
                aria-hidden="true"
              />
            )}
            <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-md">
              {index + 1}
            </span>
            <div class="lg:mt-4 lg:px-3">
              <p class="font-display text-base font-semibold text-ink">{step.label}</p>
              {step.desc && <p class="mt-1 text-sm text-ink-muted">{step.desc}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
