---
/**
 * MediaVideo — inline, muted, auto-looping video for section content
 * (e.g. a factory walkthrough).
 *
 * New or replacement videos use a CloudBase/CDN URL. A reviewed,
 * version-controlled launch asset under 20 MiB may use a stable public path;
 * `docs/IMAGE_UPLOAD_STORAGE_DESIGN.md` owns that narrow exception. When `src`
 * is omitted, the poster image renders on its own.
 */
interface Props {
  /** CloudBase/CDN URL or reviewed static-launch path. Empty ⇒ poster only. */
  src?: string;
  /** Poster / fallback image path (served from public/media). */
  poster?: string;
  /** Intrinsic pixel dimensions of `poster`, to reserve layout space (avoid CLS). */
  posterWidth: number;
  posterHeight: number;
  caption?: string;
  /** Accessible label / alt text for the media. */
  label?: string;
}

const { src, poster, posterWidth, posterHeight, caption, label } = Astro.props;
const hasVideo = Boolean(src);
const alt = label ?? caption ?? '';
---

{
  (src || poster) && (
    <figure
      class="overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-card)] ring-1 ring-black/5"
    >
      {
        hasVideo ? (
          <video
            class="aspect-video h-full w-full object-cover"
            muted
            autoplay
            loop
            playsinline
            preload="metadata"
            poster={poster}
            aria-label={label}
          >
            <source src={src} type="video/mp4" />
            {poster && (
              <img
                src={poster}
                alt={alt}
                width={posterWidth}
                height={posterHeight}
                class="aspect-video h-full w-full object-cover"
              />
            )}
          </video>
        ) : (
          <img
            src={poster}
            alt={alt}
            width={posterWidth}
            height={posterHeight}
            loading="lazy"
            decoding="async"
            class="aspect-video h-full w-full object-cover"
          />
        )
      }
      {caption && (
        <figcaption class="bg-surface px-4 py-3 text-center text-sm text-ink-soft">
          {caption}
        </figcaption>
      )}
    </figure>
  )
}
