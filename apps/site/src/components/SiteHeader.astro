---
import type { NavItem, SiteContent } from '../i18n/site.ts';
import { AccountMenu } from '../islands/auth/AccountMenu.tsx';
import { NavOverflowMenu } from '../islands/NavOverflowMenu.tsx';
import { orderPrimaryNavItems } from '../lib/site-navigation.ts';

interface Props {
  brand: SiteContent['brand'];
  nav: SiteContent['nav'];
  /** Retained for hidden legacy route compatibility. */
  showName?: boolean;
}

const { brand, nav } = Astro.props;

// Auth-related nav entries are handled by the AccountMenu island instead.
const AUTH_HREFS = ['/admin', '/login', '/register'];
const menuItems: NavItem[] = nav.items.filter((item) => !AUTH_HREFS.includes(item.href));
const orderedMenuItems = orderPrimaryNavItems(menuItems);

// Responsive nav: show first N items inline, overflow into a "More" dropdown.
// md (≥768px): 3 items; lg (≥1024px): 4 items; xl (≥1280px): all items.
const SHOW_MD = Math.min(3, orderedMenuItems.length);
const SHOW_LG = Math.min(4, orderedMenuItems.length);
const hasOverflow = orderedMenuItems.length > SHOW_MD;
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b-2 border-brand-700 bg-white/95 backdrop-blur-md shadow-[var(--shadow-header)]"
  data-site-header
>
  <div
    class="mx-auto flex h-[var(--spacing-header)] max-w-[96rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <!-- Public brand: approved CHANNEL wordmark with the legal company name. -->
    <a
      href="/"
      class="flex min-w-0 shrink-0 items-center gap-2 xl:max-w-[25rem]"
      aria-label={`${brand.name} home`}
      data-brand-link
    >
      {
        brand.logo ? (
          <img
            src={brand.logo}
            alt=""
            width="226"
            height="30"
            class="h-4 w-auto shrink-0 min-[360px]:h-5 sm:h-7 2xl:h-8"
            aria-hidden="true"
          />
        ) : (
          <span
            class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-700 font-display text-sm font-bold text-white"
            aria-hidden="true"
          >
            {brand.logoInitials}
          </span>
        )
      }
      <span
        class="max-w-24 text-[10px] font-semibold leading-tight text-ink min-[360px]:max-w-28 sm:max-w-none sm:whitespace-nowrap sm:text-xs lg:text-sm xl:text-xs 2xl:text-sm"
        aria-hidden="true"
        data-company-name
      >
        {brand.name}
      </span>
    </a>

    <!-- Primary navigation (hidden on mobile, visible md+) -->
    <nav class="hidden shrink-0 items-center gap-0.5 md:flex lg:gap-1" aria-label="Primary" data-primary-nav>
      {
        orderedMenuItems.map((item, i) => {
          // Visibility: md (<lg) → first 3; lg (<xl) → first 4; xl → all
          const hideClasses =
            i >= SHOW_MD
              ? i >= SHOW_LG
                ? 'hidden xl:inline-flex'
                : 'hidden lg:inline-flex'
              : '';
          return (
            <a
              href={item.href}
              class={`whitespace-nowrap rounded-lg px-2 py-2 text-sm font-semibold text-ink-soft transition hover:bg-brand-50 hover:text-brand-700 lg:px-3 lg:text-base ${hideClasses}`}
            >
              {item.label}
            </a>
          );
        })
      }

      <!-- "More" dropdown (React island, hidden at xl) -->
      {hasOverflow && (
        <div class="xl:hidden">
          <NavOverflowMenu items={orderedMenuItems} client:load />
        </div>
      )}
    </nav>

    <!-- Account controls (right) + mobile menu toggle -->
    <div class="flex shrink-0 items-center gap-2" data-account-controls>
      <span class="hidden md:block"><AccountMenu client:only="react" /></span>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-soft transition hover:bg-brand-50 md:hidden"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation panel -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 md:hidden"
    aria-label="Mobile"
    data-mobile-menu
  >
    {
      orderedMenuItems.map((item) => (
        <a
          href={item.href}
          class="block rounded-lg px-3 py-3 text-base font-medium text-ink-soft transition hover:bg-brand-50 hover:text-brand-700"
        >
          {item.label}
        </a>
      ))
    }
    <div class="mt-2 border-t border-slate-100 pt-3">
      <AccountMenu client:only="react" />
    </div>
  </nav>
</header>

<!-- Spacer so fixed header doesn't overlap page content -->
<div class="h-[var(--spacing-header)]" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Close the mobile menu after tapping a link.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
