---
import type { NavItem, SiteContent } from '../i18n/site.ts';

interface Props {
  brand: SiteContent['brand'];
  nav: SiteContent['nav'];
  /** When false, hide the company name and show only logo + min-order badge. */
  showName?: boolean;
}

const { brand, nav, showName = true } = Astro.props;

function isEmphasis(item: NavItem): boolean {
  return item.emphasis === true;
}
---

<header
  class="fixed inset-x-0 top-0 z-50 bg-white/85 backdrop-blur-md shadow-[var(--shadow-header)]"
  data-site-header
>
  <div
    class="mx-auto flex h-[var(--spacing-header)] max-w-[var(--width-container)] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <!-- Brand: logo + company name + minimum-order highlight -->
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={brand.name}>
      {
        brand.logo ? (
          <img
            src={brand.logo}
            alt={brand.name}
            width="226"
            height="50"
            class="h-9 w-auto shrink-0 sm:h-10"
          />
        ) : (
          <span
            class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-700 font-display text-sm font-bold text-white"
            aria-hidden="true"
          >
            {brand.logoInitials}
          </span>
        )
      }
      {
        showName ? (
          <span class="hidden min-w-0 flex-col leading-tight sm:flex">
            <span class="truncate font-display text-sm font-semibold text-ink sm:text-base">
              {brand.name}
            </span>
            <span class="mt-0.5 inline-flex w-fit items-center gap-1 rounded-full bg-accent-100 px-2 py-0.5 text-[11px] font-semibold text-accent-700">
              {brand.minOrder}
            </span>
          </span>
        ) : (
          <span class="hidden items-center sm:inline-flex">
            <span class="inline-flex w-fit items-center gap-1 rounded-full bg-accent-100 px-2.5 py-1 text-xs font-semibold text-accent-700">
              {brand.minOrder}
            </span>
          </span>
        )
      }
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.items.map((item) =>
          isEmphasis(item) ? (
            <a
              href={item.href}
              class="ml-2 inline-flex items-center rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-800"
            >
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft transition hover:bg-brand-50 hover:text-brand-700"
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <!-- Mobile menu toggle -->
    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-soft transition hover:bg-brand-50 lg:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile navigation panel -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 lg:hidden"
    aria-label="Mobile"
    data-mobile-menu
  >
    {
      nav.items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block rounded-lg px-3 py-3 text-base font-medium transition',
            isEmphasis(item)
              ? 'mt-1 bg-brand-700 text-center text-white hover:bg-brand-800'
              : 'text-ink-soft hover:bg-brand-50 hover:text-brand-700',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<!-- Spacer so fixed header doesn't overlap page content -->
<div class="h-[var(--spacing-header)]" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Close the mobile menu after tapping a link.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
