---
/**
 * ProjectForm — OEM project submission form.
 *
 * Fields are data-driven from the page content. The form degrades gracefully
 * without JS (native validation); with JS it submits asynchronously and shows
 * an inline success state. The submit endpoint is left as a data attribute so a
 * backend (e.g. an `inquiries` collection) can be wired later.
 */
import type { FormField } from '../i18n/oem.ts';
import PublicSelect from './form/PublicSelect.astro';

interface Props {
  fields: FormField[];
  submitLabel: string;
  disclaimer: string;
  successTitle: string;
  successBody: string;
  /** Optional backend endpoint to POST to. */
  action?: string;
  /** When set, redirect here (with ?id=) after a successful submission. */
  resultPath?: string;
}

const {
  fields,
  submitLabel,
  disclaimer,
  successTitle,
  successBody,
  action = '',
  resultPath = '',
} = Astro.props;

const fieldBase =
  'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-ink shadow-sm outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20';
---

<div
  class="overflow-hidden rounded-[var(--radius-card)] border border-slate-200 bg-surface shadow-[var(--shadow-card)]"
>
  <form
    class="grid grid-cols-1 gap-5 p-6 sm:grid-cols-2 sm:p-8"
    data-project-form
    data-endpoint={action}
    data-result={resultPath}
    novalidate
  >
    {
      fields.map((field) =>
        field.type === 'select' ? (
          <PublicSelect
            name={field.name}
            label={field.label}
            options={field.options ?? []}
            required={field.required}
            hint={field.hint}
            wrapperClass={field.full ? 'sm:col-span-2' : ''}
          />
        ) : (
          <div class:list={[field.full ? 'sm:col-span-2' : '']}>
          <label for={field.name} class="block text-sm font-medium text-ink">
            {field.label}
            {field.required && <span class="text-red-500"> *</span>}
          </label>

          {field.type === 'file' ? (
            <input
              id={field.name}
              name={field.name}
              type="file"
              accept={field.accept}
              class:list={[
                fieldBase,
                'file:mr-3 file:rounded-md file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-brand-700 hover:file:bg-brand-100',
              ]}
            />
          ) : (
            <input
              id={field.name}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              required={field.required}
              class={fieldBase}
            />
          )}

          {field.hint && (
            <p id={`${field.name}-hint`} class="mt-1.5 text-xs leading-relaxed text-ink-muted">
              {field.hint}
            </p>
          )}
        </div>
        ),
      )
    }

    <div class="sm:col-span-2">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-md text-xs text-ink-muted">{disclaimer}</p>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800 disabled:opacity-60"
          data-submit
        >
          {submitLabel}
        </button>
      </div>
      <p class="mt-3 hidden text-sm font-medium text-red-600" data-error role="alert"></p>
    </div>
  </form>

  <!-- Success state (revealed after submit) -->
  <div class="hidden p-8 text-center sm:p-12" data-success>
    <span
      class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-600"
    >
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 13l4 4L19 7"></path>
      </svg>
    </span>
    <h3 class="mt-5 font-display text-xl font-semibold text-ink" data-success-title>{successTitle}</h3>
    <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-ink-soft">{successBody}</p>
  </div>
</div>

<script>
  import { apiUrl } from '../lib/api-url.ts';
  import { OEM_FILE_MAX_BYTES, isAllowedOemExtension } from '@vibelingan-channel/shared';

  const form = document.querySelector<HTMLFormElement>('[data-project-form]');
  const root = form?.closest('div');
  const success = root?.querySelector<HTMLElement>('[data-success]');
  const errorEl = form?.querySelector<HTMLElement>('[data-error]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const submitLabel = submitBtn?.textContent ?? 'Submit';
  const maxMiB = Math.floor(OEM_FILE_MAX_BYTES / (1024 * 1024));

  interface OemIntent {
    fileId: string;
    uploadIntentId: string;
    uploadSecret: string;
    upload: { method: string; url: string; headers: Record<string, string> };
  }

  function resetButton() {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  }

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    resetButton();
  }

  /** POST an admin-API action and return its `data`, throwing a clear error otherwise. */
  async function postAction<T>(endpoint: string, action: string, data: unknown): Promise<T> {
    const res = await fetch(apiUrl(endpoint), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, data }),
    });
    const json = await res.json().catch(() => null);
    if (!res.ok || !json?.ok) {
      throw new Error(json?.error?.message ?? `Request failed (${res.status})`);
    }
    return json.data as T;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    errorEl?.classList.add('hidden');

    // Collect text fields; capture the drawing file separately (never as base64).
    const data: Record<string, string> = {};
    let file: File | undefined;
    for (const el of Array.from(form.elements)) {
      const field = el as HTMLInputElement | HTMLSelectElement;
      if (!field.name) continue;
      if (field instanceof HTMLInputElement && field.type === 'file') {
        file = field.files?.[0] ?? undefined;
      } else {
        data[field.name] = field.value;
      }
    }

    // Advisory client-side validation (the server re-validates authoritatively).
    if (file) {
      if (file.size > OEM_FILE_MAX_BYTES) {
        showError(`That file is too large — the maximum is ${maxMiB} MiB.`);
        return;
      }
      if (!isAllowedOemExtension(file.name)) {
        showError('Unsupported file type. Please upload a PDF, ZIP, RAR, CAD, or image file.');
        return;
      }
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';
    }

    const endpoint = form.dataset.endpoint;
    const resultPath = form.dataset.result;
    try {
      if (endpoint) {
        // Attach a drawing by uploading its bytes DIRECTLY to storage first, then
        // referencing the pending row from the project. The bytes never transit
        // the function's small JSON body cap (MIU-08 §20.10).
        if (file) {
          if (submitBtn) submitBtn.textContent = 'Uploading…';
          const intent = await postAction<OemIntent>(endpoint, 'createOemFileUploadIntent', {
            fileName: file.name,
            mimeType: file.type || 'application/octet-stream',
            byteSize: file.size,
          });
          // Raw PUT straight to COS with the server-minted credential headers.
          // The browser never holds a storage identity. NOT a multipart POST:
          // @cloudbase/node-sdk 3.x signs the upload for `put`, so a form POST
          // is rejected 403 SignatureDoesNotMatch.
          const put = await fetch(intent.upload.url, {
            method: intent.upload.method,
            headers: intent.upload.headers,
            body: file,
          });
          if (!put.ok) {
            // Leave the pending row for expiry/cleanup; surface a clear error.
            throw new Error(`File upload failed (${put.status}). Please try again.`);
          }
          data.drawingName = file.name;
          data.drawingFileId = intent.fileId;
          data.uploadIntentId = intent.uploadIntentId;
          data.uploadSecret = intent.uploadSecret;
        }

        if (submitBtn) submitBtn.textContent = 'Submitting…';
        const result = await postAction<{ id?: string }>(endpoint, 'submitProject', data);

        // Redirect to a dedicated result page carrying the new reference id.
        if (resultPath && result?.id) {
          window.location.href = `${resultPath}?id=${encodeURIComponent(result.id)}`;
          return;
        }
      } else {
        // No backend wired yet — simulate a successful submission.
        await new Promise((resolve) => setTimeout(resolve, 600));
      }
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Something went wrong. Please try again.');
    }
  });
</script>
