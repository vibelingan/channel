---
import type { Certificate } from '../i18n/portfolio.ts';
import CarouselControls from './CarouselControls.astro';

interface Props {
  certs: Certificate[];
  complianceLabel: string;
  designPatentLabel: string;
  patentRecordLabel: string;
}

const { certs, complianceLabel, designPatentLabel, patentRecordLabel } = Astro.props;

const groups = [
  { label: complianceLabel, items: certs.filter((cert) => cert.kind === 'compliance') },
  {
    label: designPatentLabel,
    items: certs.filter((cert) => cert.kind === 'design-patent'),
  },
  { label: patentRecordLabel, items: certs.filter((cert) => cert.kind === 'patent-record') },
].filter((g) => g.items.length > 0);
---

<div class="space-y-12">
  {
    groups.map((group, groupIndex) => (
      <div
        data-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label={group.label}
      >
        <h3 class="font-display text-lg font-semibold text-ink">{group.label}</h3>
        <ul
          id={`certificate-carousel-${groupIndex}`}
          class="mt-5 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] motion-reduce:scroll-auto [&::-webkit-scrollbar]:hidden lg:grid lg:grid-cols-4 lg:overflow-visible lg:snap-none lg:pb-0"
          data-carousel-track
          tabindex="0"
        >
          {group.items.map((cert, certIndex) => (
            <li
              class="cert-item reveal basis-[82%] shrink-0 snap-start sm:basis-[calc(50%-0.625rem)] lg:basis-auto"
              data-carousel-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${certIndex + 1} of ${group.items.length}`}
            >
              <button
                type="button"
                class="cert-trigger group flex h-full w-full cursor-zoom-in flex-col overflow-hidden rounded-[var(--radius-card)] bg-white text-left shadow-[var(--shadow-card)] outline-none ring-1 ring-black/5 transition hover:ring-brand-500/40 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2"
                aria-haspopup="dialog"
                aria-label={`Enlarge certificate: ${cert.label}`}
              >
                <img
                  src={cert.src}
                  alt={cert.label}
                  width={cert.width}
                  height={cert.height}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/4] w-full flex-1 bg-white object-contain p-2"
                />
                <span class="flex min-h-14 items-center justify-center border-t border-black/5 px-3 py-2 text-center text-xs text-ink-soft">
                  {cert.label}
                </span>
              </button>
              <dialog
                class="cert-dialog w-[min(92vw,42rem)] rounded-[var(--radius-card)] bg-white p-0 shadow-2xl backdrop:bg-black/70"
                aria-label={cert.label}
              >
                <div class="relative">
                  <form method="dialog" class="absolute right-3 top-3 z-10">
                    <button
                      type="submit"
                      class="flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-white outline-none transition hover:bg-black/80 focus-visible:ring-2 focus-visible:ring-white"
                      aria-label="Close"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
                      </svg>
                    </button>
                  </form>
                  <img
                    src={cert.src}
                    alt={cert.label}
                    width={cert.width}
                    height={cert.height}
                    decoding="async"
                    class="max-h-[80vh] w-full bg-white object-contain p-4"
                  />
                  <p class="border-t border-black/5 px-4 py-3 text-center text-sm text-ink-soft">
                    {cert.label}
                  </p>
                </div>
              </dialog>
            </li>
          ))}
        </ul>
        <CarouselControls
          trackId={`certificate-carousel-${groupIndex}`}
          itemCount={group.items.length}
        />
      </div>
    ))
  }
</div>

<script>
  // Progressive enhancement: open each certificate in its lightbox <dialog>.
  // Native <dialog> provides Esc-to-close and a focus trap; we add click-to-open
  // and backdrop-click-to-close. Without JS the thumbnails still render.
  for (const item of document.querySelectorAll<HTMLElement>('.cert-item')) {
    const trigger = item.querySelector<HTMLButtonElement>('.cert-trigger');
    const dialog = item.querySelector<HTMLDialogElement>('.cert-dialog');
    if (!trigger || !dialog) continue;
    trigger.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
