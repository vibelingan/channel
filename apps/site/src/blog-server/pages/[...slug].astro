---
import type { ArticleSummary } from '@vibelingan-channel/articles/public-read';
import type { ArticleWebPresentation } from '@vibelingan-channel/articles/web-media';
import BlogView from '../../components/BlogView.astro';
import { publicArticleForRender, publicArticleList } from '../../lib/blog/server-client.ts';
import NotFound from '../../pages/404.astro';
const slug = Astro.params.slug;
let article = null;
let presentation: ArticleWebPresentation | undefined;
let articles: ArticleSummary[] = [];
let next = null;
let unavailable = false;
Astro.response.headers.set('Cache-Control', 'no-store');
try {
  if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    const started = performance.now();
    const rendered = await publicArticleForRender(slug);
    Astro.response.headers.set('Server-Timing', `article-read;dur=${(performance.now() - started).toFixed(1)}`);
    article = rendered?.article ?? null;
    presentation = rendered?.presentation;
    if (rendered) Astro.response.headers.set('X-Article-Presentation', rendered.format);
  } else if (slug) article = null;
  else {
    const started = performance.now();
    ({ articles, next } = await publicArticleList());
    Astro.response.headers.set('Server-Timing', `article-read;dur=${(performance.now() - started).toFixed(1)}`);
  }
} catch {
  unavailable = true;
}
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else if (slug && !article) Astro.response.status = 404;
---
{unavailable ? <html lang="en"><head><title>Insights temporarily unavailable</title><meta name="robots" content="noindex" /></head><body><h1>Insights temporarily unavailable</h1><p>Please try again shortly.</p></body></html> : slug && !article ? <NotFound /> : <BlogView articles={articles} article={article} presentation={presentation} next={next} server />}
