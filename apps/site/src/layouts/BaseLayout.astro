---
import '../styles/global.css';

interface SocialImage {
  path: string;
  alt: string;
  width: number;
  height: number;
  mimeType: 'image/png' | 'image/jpeg' | 'image/webp';
}

interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  noindex?: boolean;
  robots?: 'index,follow' | 'noindex,follow' | 'noindex,nofollow';
  socialImage?: SocialImage;
  schemaNodes?: Record<string, unknown>[];
}

const defaultSocialImage: SocialImage = {
  path: '/media/social/oem-manufacturing-og.png',
  alt: 'OEM product assembly and packing line at the Dongguan production facility',
  width: 1200,
  height: 630,
  mimeType: 'image/png',
};

const {
  title,
  description = 'OEM/ODM manufacturing partner. Engineered in Hong Kong, manufactured in Dongguan, China — from idea to shipment.',
  lang = 'en',
  canonicalPath,
  noindex = false,
  robots = noindex ? 'noindex,nofollow' : 'index,follow',
  socialImage = defaultSocialImage,
  schemaNodes = [],
} = Astro.props;

// Every public page self-canonicalizes by default; pass canonicalPath to override
// (e.g. /portfolio/ is the canonical home of the old /success-stories content).
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin);
const socialImageUrl = new URL(socialImage.path, siteOrigin);

const homeUrl = new URL('/', siteOrigin).href;
const orgId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;

// Global structured data. Facts must match src/i18n/content/en-US.md — do not
// add claims (street address, social profiles, awards) until the client
// supplies them. TODO: add `logo` once a PNG logo exists (Google ignores SVG).
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Diversity Technology',
      legalName: 'Diversity Technology Limited',
      url: homeUrl,
      description:
        'OEM/ODM manufacturing partner. Product design, engineering, tooling, production, quality control, and global delivery — engineered in Hong Kong, manufactured in Dongguan, China.',
      foundingDate: '2004',
      slogan: 'OEM / ODM Manufacturing Partner',
      email: 'info@supplychainsai.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Hong Kong',
        addressCountry: 'HK',
      },
      location: {
        '@type': 'Place',
        name: 'Dongguan Production Facility',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Dongguan',
          addressRegion: 'Guangdong',
          addressCountry: 'CN',
        },
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: 'info@supplychainsai.com',
        telephone: '+852 6941 6140',
        availableLanguage: ['English'],
      },
      knowsAbout: [
        'OEM manufacturing',
        'ODM product development',
        'Consumer electronics engineering',
        'Tooling and injection molding',
        'Quality control and testing',
        'Export logistics and global delivery',
      ],
      areaServed: 'Worldwide',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl,
      name: 'Diversity Technology',
      publisher: { '@id': orgId },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': orgId },
      inLanguage: 'en',
    },
    ...schemaNodes,
  ],
};
const serializedSchemaGraph = JSON.stringify(schemaGraph).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots !== 'index,follow' && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      robots === 'index,follow' && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Diversity Technology" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl.href} />
          <meta property="og:image" content={socialImageUrl.href} />
          <meta property="og:image:secure_url" content={socialImageUrl.href} />
          <meta property="og:image:type" content={socialImage.mimeType} />
          <meta property="og:image:width" content={String(socialImage.width)} />
          <meta property="og:image:height" content={String(socialImage.height)} />
          <meta property="og:image:alt" content={socialImage.alt} />
          <meta property="og:locale" content="en_US" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImageUrl.href} />
          <meta name="twitter:image:alt" content={socialImage.alt} />
        </>
      )
    }
    {robots === 'index,follow' && <script type="application/ld+json" set:html={serializedSchemaGraph} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#153687" />
    <meta name="theme-color" content="#153687" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="h-full antialiased">
    <slot />

    <script>
      // Only below-fold nodes are hidden after observer registration. Initial,
      // no-JS, reduced-motion, and observer-unavailable content stays visible.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && els.length > 0 && !reducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const element = entry.target as HTMLElement;
                if (element.classList.contains('reveal-pending')) {
                  let cleanupTimer = 0;
                  const finish = (event?: TransitionEvent) => {
                    if (
                      event &&
                      (event.target !== element || event.propertyName !== 'opacity')
                    ) {
                      return;
                    }
                    window.clearTimeout(cleanupTimer);
                    element.classList.remove('reveal-pending', 'is-visible');
                    element.removeEventListener('transitionend', finish);
                  };
                  element.addEventListener('transitionend', finish);
                  element.classList.add('is-visible');
                  cleanupTimer = window.setTimeout(finish, 800);
                }
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        els.forEach((element) => {
          try {
            observer.observe(element);
          } catch {
            return;
          }
          if (element.getBoundingClientRect().top >= window.innerHeight) {
            element.classList.add('reveal-pending');
          }
        });
      }
    </script>
  </body>
</html>
