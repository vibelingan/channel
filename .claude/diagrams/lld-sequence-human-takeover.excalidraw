{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "widget",
      "type": "rectangle",
      "x": 60,
      "y": 40,
      "width": 180,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Visitor Widget",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "sales",
      "type": "rectangle",
      "x": 330,
      "y": 40,
      "width": 180,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Sales Admin",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "bff",
      "type": "rectangle",
      "x": 600,
      "y": 40,
      "width": 180,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "opacity": 100,
      "text": "Chat BFF",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "pg",
      "type": "rectangle",
      "x": 870,
      "y": 40,
      "width": 180,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "PostgreSQL",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "hermes",
      "type": "rectangle",
      "x": 1140,
      "y": 40,
      "width": 180,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "opacity": 100,
      "text": "Hermes Runs API",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "a1",
      "type": "arrow",
      "x": 240,
      "y": 170,
      "width": 360,
      "height": 0,
      "points": [[0, 0], [360, 0]],
      "startBinding": {"elementId": "widget", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "label": {"text": "1. POST user message + Idempotency-Key", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a2",
      "type": "arrow",
      "x": 780,
      "y": 230,
      "width": 90,
      "height": 0,
      "points": [[0, 0], [90, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "pg", "gap": 5, "focus": 0},
      "label": {"text": "2. TX: message + CREATING run\n(operationId, V) + start outbox", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a3",
      "type": "arrow",
      "x": 780,
      "y": 300,
      "width": 360,
      "height": 0,
      "points": [[0, 0], [360, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "hermes", "gap": 5, "focus": 0},
      "label": {"text": "3. Worker POST /v1/runs\nIdempotency-Key = operationId", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a4",
      "type": "arrow",
      "x": 1140,
      "y": 360,
      "width": -360,
      "height": 0,
      "points": [[0, 0], [-360, 0]],
      "startBinding": {"elementId": "hermes", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "label": {"text": "4. run_id → conditional register\nor reconcile+stop if fence lost", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a5",
      "type": "arrow",
      "x": 600,
      "y": 430,
      "width": -360,
      "height": 0,
      "points": [[0, 0], [-360, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "widget", "gap": 5, "focus": 0},
      "label": {"text": "5. PG TX append AI event(sequence)\nSSE sends committed event only", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a6",
      "type": "arrow",
      "x": 510,
      "y": 520,
      "width": 90,
      "height": 0,
      "points": [[0, 0], [90, 0]],
      "startBinding": {"elementId": "sales", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "label": {"text": "6. POST takeover (JWT)", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a7",
      "type": "arrow",
      "x": 780,
      "y": 580,
      "width": 90,
      "height": 0,
      "points": [[0, 0], [90, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "pg", "gap": 5, "focus": 0},
      "label": {"text": "7. Row-lock TX → HUMAN_ACTIVE\nV→V+1 + handoff event + cancel outbox", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a8",
      "type": "arrow",
      "x": 600,
      "y": 650,
      "width": -360,
      "height": 0,
      "points": [[0, 0], [-360, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "widget", "gap": 5, "focus": 0},
      "label": {"text": "8. Dispatcher sends committed\nhandoff.started(sequence N)", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a9",
      "type": "arrow",
      "x": 780,
      "y": 720,
      "width": 360,
      "height": 0,
      "points": [[0, 0], [360, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "hermes", "gap": 5, "focus": 0},
      "label": {"text": "9. POST /v1/runs/{run_id}/stop (retryable)", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a10",
      "type": "arrow",
      "x": 1140,
      "y": 790,
      "width": -360,
      "height": 0,
      "points": [[0, 0], [-360, 0]],
      "startBinding": {"elementId": "hermes", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "label": {"text": "10. Late token/completion or late run_id (V)", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a11",
      "type": "arrow",
      "x": 780,
      "y": 850,
      "width": 90,
      "height": 0,
      "points": [[0, 0], [90, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "pg", "gap": 5, "focus": 0},
      "label": {"text": "11. Row-lock rejects event append\nreconcile stop; mark DISCARDED", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a12",
      "type": "arrow",
      "x": 600,
      "y": 920,
      "width": -360,
      "height": 0,
      "points": [[0, 0], [-360, 0]],
      "startBinding": {"elementId": "bff", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "widget", "gap": 5, "focus": 0},
      "label": {"text": "12. No late AI token; human channel active", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  },
  "files": {}
}
