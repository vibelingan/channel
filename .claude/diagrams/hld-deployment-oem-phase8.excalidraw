      "roughness": 1,
      "opacity": 100,
      "text": "GitHub Actions\n[build, package, smoke]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "static-hosting",
