      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase static hosting\n[listing and result HTML]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "admin-function",
      "type": "rectangle",
      "x": 1180,
      "y": 330,
      "width": 240,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
