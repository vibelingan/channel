    },
    {
      "id": "public-domain",
      "type": "rectangle",
      "x": 1580,
      "y": 70,
      "width": 240,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd43b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "supplychainsai.com\n[canonical live acceptance]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "oem-to-test",
      "type": "arrow",
      "x": 280,
      "y": 250,
      "width": 140,
      "height": 0,
      "points": [[0, 0], [140, 0]],
      "startBinding": {"elementId": "oem-branch", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "test-branch", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "verify remote SHA then FF", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "test-to-actions",
      "type": "arrow",
      "x": 640,
      "y": 250,
      "width": 140,
      "height": 0,
      "points": [[0, 0], [140, 0]],
      "startBinding": {"elementId": "test-branch", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "github-actions", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "push triggers Deploy Test", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "actions-to-hosting",
      "type": "arrow",
      "x": 1020,
      "y": 225,
      "width": 160,
      "height": -105,
      "points": [[0, 0], [160, -105]],
      "startBinding": {"elementId": "github-actions", "gap": 5, "focus": -0.25},
      "endBinding": {"elementId": "static-hosting", "gap": 5, "focus": 0.25},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "upload static dist", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "actions-to-function",
      "type": "arrow",
      "x": 1020,
      "y": 275,
      "width": 160,
      "height": 105,
      "points": [[0, 0], [160, 105]],
      "startBinding": {"elementId": "github-actions", "gap": 5, "focus": 0.25},
      "endBinding": {"elementId": "admin-function", "gap": 5, "focus": -0.25},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "deploy packaged function", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "hosting-to-domain",
      "type": "arrow",
      "x": 1420,
      "y": 120,
      "width": 160,
      "height": 0,
      "points": [[0, 0], [160, 0]],
      "startBinding": {"elementId": "static-hosting", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "public-domain", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "cache-busted live smoke", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20},
  "files": {}
}