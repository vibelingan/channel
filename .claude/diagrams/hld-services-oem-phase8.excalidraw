{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "content-sources",
      "type": "rectangle",
      "x": 60,
      "y": 60,
      "width": 240,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Content producers\n[OEM + hidden Markdown]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "listing-pages",
      "type": "rectangle",
      "x": 60,
      "y": 300,
      "width": 240,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Listing pages\n[Teardown + Blue Ocean]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "astro-build",
      "type": "rectangle",
      "x": 480,
      "y": 180,
      "width": 240,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Astro build\n[static HTML]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "email-package",
      "type": "rectangle",
      "x": 60,
      "y": 540,
      "width": 240,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Email package\n[text + HTML SLA]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "admin-bundle",
      "type": "rectangle",
      "x": 480,
      "y": 520,
      "width": 240,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Admin function bundle\n[tsup noExternal]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "static-hosting",
      "type": "rectangle",
      "x": 900,
      "y": 180,
      "width": 240,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase hosting\n[existing paths overwritten]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "cloud-function",
      "type": "rectangle",
      "x": 900,
      "y": 520,
      "width": 240,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase admin function\n[confirmation email runtime]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "content-to-astro",
      "type": "arrow",
      "x": 300,
      "y": 110,
      "width": 180,
      "height": 100,
      "points": [[0, 0], [180, 100]],
      "startBinding": {"elementId": "content-sources", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "astro-build", "gap": 5, "focus": -0.35},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "typed content load", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "listings-to-astro",
      "type": "arrow",
      "x": 300,
      "y": 350,
      "width": 180,
      "height": -80,
      "points": [[0, 0], [180, -80]],
      "startBinding": {"elementId": "listing-pages", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "astro-build", "gap": 5, "focus": 0.35},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "render cards without stats", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "astro-to-hosting",
      "type": "arrow",
      "x": 720,
      "y": 240,
      "width": 180,
      "height": 0,
      "points": [[0, 0], [180, 0]],
      "startBinding": {"elementId": "astro-build", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "static-hosting", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "upload dist", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "email-to-admin",
      "type": "arrow",
      "x": 300,
      "y": 590,
      "width": 180,
      "height": -10,
      "points": [[0, 0], [180, -10]],
      "startBinding": {"elementId": "email-package", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "admin-bundle", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "bundle workspace package", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "admin-to-function",
      "type": "arrow",
      "x": 720,
      "y": 580,
      "width": 180,
      "height": 0,
      "points": [[0, 0], [180, 0]],
      "startBinding": {"elementId": "admin-bundle", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "cloud-function", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "package and deploy", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20},
  "files": {}
}