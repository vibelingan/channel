{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "visitor",
      "type": "ellipse",
      "x": 80,
      "y": 150,
      "width": 210,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Site visitor\n[browses products and submits OEM form]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "channel",
      "type": "rectangle",
      "x": 500,
      "y": 110,
      "width": 310,
      "height": 170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Channel platform\n[Astro site + CloudBase functions]\nforms, catalog, pricing and media fallback",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "cloudbase",
      "type": "rectangle",
      "x": 1020,
      "y": 40,
      "width": 260,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase managed data\n[NoSQL + private storage]\nrefcount-gated product media",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "operations",
      "type": "ellipse",
      "x": 1020,
      "y": 260,
      "width": 260,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd43b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Admin operator\n[reviews and reconciles media counters]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "visitor-channel",
      "type": "arrow",
      "x": 290,
      "y": 195,
      "width": 210,
      "height": 0,
      "points": [[0, 0], [210, 0]],
      "startBinding": {"elementId": "visitor", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "channel", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "HTTPS: browse, select, submit", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "channel-api",
      "type": "arrow",
      "x": 810,
      "y": 155,
      "width": 210,
      "height": -55,
      "points": [[0, 0], [210, -55]],
      "startBinding": {"elementId": "channel", "gap": 5, "focus": -0.3},
      "endBinding": {"elementId": "cloudbase", "gap": 5, "focus": 0.25},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "reads metadata and gated bytes", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "operations-api",
      "type": "arrow",
      "x": 1020,
      "y": 315,
      "width": -210,
      "height": -70,
      "points": [[0, 0], [-210, -70]],
      "startBinding": {"elementId": "operations", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "channel", "gap": 5, "focus": 0.3},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "admin API: dry-run and apply", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20},
  "files": {}
