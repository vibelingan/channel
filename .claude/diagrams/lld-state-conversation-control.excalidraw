{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "start",
      "type": "ellipse",
      "x": 60,
      "y": 250,
      "width": 50,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "bot-active",
      "type": "rectangle",
      "x": 220,
      "y": 210,
      "width": 220,
      "height": 120,
      "roundness": {"type": 3},
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "opacity": 100,
      "text": "BOT_ACTIVE\nAI may create one run\nrun captures modeVersion",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "handoff-requested",
      "type": "rectangle",
      "x": 590,
      "y": 40,
      "width": 250,
      "height": 120,
      "roundness": {"type": 3},
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd43b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "HANDOFF_REQUESTED\nNo new AI runs\nWaiting for sales claim",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "human-active",
      "type": "rectangle",
      "x": 590,
      "y": 360,
      "width": 250,
      "height": 140,
      "roundness": {"type": 3},
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "opacity": 100,
      "text": "HUMAN_ACTIVE\nmodeVersion incremented\nOld runs stopped/discarded\nSales messages only",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "closed",
      "type": "rectangle",
      "x": 1000,
      "y": 210,
      "width": 210,
      "height": 120,
      "roundness": {"type": 3},
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "opacity": 100,
      "text": "CLOSED\nTerminal\nRetention policy starts",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "end",
      "type": "ellipse",
      "x": 1340,
      "y": 245,
      "width": 60,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 5,
      "roughness": 1,
      "opacity": 100,
      "text": "",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "a-start",
      "type": "arrow",
      "x": 110,
      "y": 275,
      "width": 110,
      "height": -5,
      "points": [[0, 0], [110, -5]],
      "startBinding": {"elementId": "start", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "bot-active", "gap": 5, "focus": 0},
      "label": {"text": "conversation created", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-request",
      "type": "arrow",
      "x": 440,
      "y": 225,
      "width": 150,
      "height": -115,
      "points": [[0, 0], [150, -115]],
      "startBinding": {"elementId": "bot-active", "gap": 5, "focus": -0.4},
      "endBinding": {"elementId": "handoff-requested", "gap": 5, "focus": 0},
      "label": {"text": "visitor asks human / low confidence", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-direct-takeover",
      "type": "arrow",
      "x": 440,
      "y": 310,
      "width": 150,
      "height": 105,
      "points": [[0, 0], [150, 105]],
      "startBinding": {"elementId": "bot-active", "gap": 5, "focus": 0.4},
      "endBinding": {"elementId": "human-active", "gap": 5, "focus": 0},
      "label": {"text": "sales CAS takeover", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-claim",
      "type": "arrow",
      "x": 715,
      "y": 160,
      "width": 0,
      "height": 200,
      "points": [[0, 0], [0, 200]],
      "startBinding": {"elementId": "handoff-requested", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "human-active", "gap": 5, "focus": 0},
      "label": {"text": "sales CAS claim + cancellation outbox", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-return",
      "type": "arrow",
      "x": 590,
      "y": 430,
      "width": -150,
      "height": -120,
      "points": [[0, 0], [-150, -120]],
      "startBinding": {"elementId": "human-active", "gap": 5, "focus": -0.2},
      "endBinding": {"elementId": "bot-active", "gap": 5, "focus": 0.35},
      "label": {"text": "authorized return-to-AI\nmodeVersion + 1", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-bot-close",
      "type": "arrow",
      "x": 440,
      "y": 275,
      "width": 560,
      "height": 0,
      "points": [[0, 0], [560, 0]],
      "startBinding": {"elementId": "bot-active", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "closed", "gap": 5, "focus": 0},
      "label": {"text": "visitor/admin closes", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-human-close",
      "type": "arrow",
      "x": 840,
      "y": 420,
      "width": 160,
      "height": -120,
      "points": [[0, 0], [160, -120]],
      "startBinding": {"elementId": "human-active", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "closed", "gap": 5, "focus": 0.35},
      "label": {"text": "sales/user closes", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-request-close",
      "type": "arrow",
      "x": 840,
      "y": 110,
      "width": 160,
      "height": 120,
      "points": [[0, 0], [160, 120]],
      "startBinding": {"elementId": "handoff-requested", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "closed", "gap": 5, "focus": -0.35},
      "label": {"text": "visitor closes", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "a-end",
      "type": "arrow",
      "x": 1210,
      "y": 270,
      "width": 130,
      "height": 5,
      "points": [[0, 0], [130, 5]],
      "startBinding": {"elementId": "closed", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "end", "gap": 5, "focus": 0},
      "label": {"text": "retained / deleted by policy", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  },
  "files": {}
}
