{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "content-owner",
      "type": "ellipse",
      "x": 80,
      "y": 180,
      "width": 200,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Content owner\n[PPT-approved claims]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "channel-system",
      "type": "rectangle",
      "x": 480,
      "y": 140,
      "width": 280,
      "height": 170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Channel OEM platform\n[Astro static site +\nCloudBase admin function]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "site-visitor",
      "type": "ellipse",
      "x": 980,
      "y": 70,
      "width": 200,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Site visitor\n[reads listings and claims]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "email-recipient",
      "type": "ellipse",
      "x": 980,
      "y": 300,
      "width": 200,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Inquiry sender\n[receives confirmation]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "owner-to-system",
      "type": "arrow",
      "x": 280,
      "y": 225,
      "width": 200,
      "height": 0,
      "points": [[0, 0], [200, 0]],
      "startBinding": {"elementId": "content-owner", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "channel-system", "gap": 5, "focus": 0},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "approves PPT claims and removals", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "system-to-visitor",
      "type": "arrow",
      "x": 760,
      "y": 185,
      "width": 220,
      "height": -70,
      "points": [[0, 0], [220, -70]],
      "startBinding": {"elementId": "channel-system", "gap": 5, "focus": -0.35},
      "endBinding": {"elementId": "site-visitor", "gap": 5, "focus": 0.2},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "serves static pages", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "system-to-recipient",
      "type": "arrow",
      "x": 760,
      "y": 265,
      "width": 220,
      "height": 80,
      "points": [[0, 0], [220, 80]],
      "startBinding": {"elementId": "channel-system", "gap": 5, "focus": 0.35},
      "endBinding": {"elementId": "email-recipient", "gap": 5, "focus": -0.2},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "sends SLA confirmation", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20},
  "files": {}
}