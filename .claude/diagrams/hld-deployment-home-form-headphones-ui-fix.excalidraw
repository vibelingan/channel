{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "browser",
      "type": "ellipse",
      "x": 60,
      "y": 180,
      "width": 210,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "Visitor browser\n[SSR HTML + hydrated island]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "static-app",
      "type": "rectangle",
      "x": 450,
      "y": 50,
      "width": 270,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase Web App / CDN\n[Astro pages and JS]\nhero bytes stay behind API gate",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "gateway-functions",
      "type": "rectangle",
      "x": 450,
      "y": 310,
      "width": 270,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase gateway + functions\n[public-api and admin]\nrelease ID + CORS contracts",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "managed-data",
      "type": "rectangle",
      "x": 990,
      "y": 180,
      "width": 280,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "CloudBase managed data\n[NoSQL metadata + private COS bytes]\nstorage-backed media gate",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "ci",
      "type": "rectangle",
      "x": 990,
      "y": 430,
      "width": 280,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd43b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "text": "GitHub Actions test deploy\n[function package, site build,\nPlaywright and media smoke]",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "browser-static",
      "type": "arrow",
      "x": 270,
      "y": 205,
      "width": 180,
      "height": -90,
      "points": [[0, 0], [180, -90]],
      "startBinding": {"elementId": "browser", "gap": 5, "focus": -0.25},
      "endBinding": {"elementId": "static-app", "gap": 5, "focus": 0.2},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "HTTPS static HTML and assets", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "browser-functions",
      "type": "arrow",
      "x": 270,
      "y": 245,
      "width": 180,
      "height": 115,
      "points": [[0, 0], [180, 115]],
      "startBinding": {"elementId": "browser", "gap": 5, "focus": 0.25},
      "endBinding": {"elementId": "gateway-functions", "gap": 5, "focus": -0.2},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "HTTPS catalog, image and OEM APIs", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "functions-data",
      "type": "arrow",
      "x": 720,
      "y": 365,
      "width": 270,
      "height": -100,
      "points": [[0, 0], [270, -100]],
      "startBinding": {"elementId": "gateway-functions", "gap": 5, "focus": 0},
      "endBinding": {"elementId": "managed-data", "gap": 5, "focus": 0.2},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "SDK reads/writes and byte proxy", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "ci-static",
      "type": "arrow",
      "x": 990,
      "y": 465,
      "width": -270,
      "height": -345,
      "points": [[0, 0], [-270, -345]],
      "startBinding": {"elementId": "ci", "gap": 5, "focus": -0.25},
      "endBinding": {"elementId": "static-app", "gap": 5, "focus": 0.25},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "upload versioned site build", "fontSize": 14, "fontFamily": 5}
    },
    {
      "id": "ci-functions",
      "type": "arrow",
      "x": 990,
      "y": 495,
      "width": -270,
      "height": -85,
      "points": [[0, 0], [-270, -85]],
      "startBinding": {"elementId": "ci", "gap": 5, "focus": 0.25},
      "endBinding": {"elementId": "gateway-functions", "gap": 5, "focus": 0.25},
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "label": {"text": "package, deploy and smoke functions", "fontSize": 14, "fontFamily": 5}
    }
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20},
  "files": {}
}