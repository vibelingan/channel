# ---------------------------------------------------------------------------
# CloudBase / wx-server-sdk (production cloud functions)
# ---------------------------------------------------------------------------
# The CloudBase environment id used by wx-server-sdk cloud.init({ env }).
TCB_ENV=your-cloudbase-env-id

# ---------------------------------------------------------------------------
# Authentication & entitlement
# ---------------------------------------------------------------------------
# Secret used to sign user session JWTs (role embedded). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Bootstrap admin account, seeded on first run. New self-registered users get
# the blank base role; an admin grants roles (admin/contributor/member/viewer).
ADMIN_EMAIL=admin@channel.local
ADMIN_PASSWORD=admin

# Absolute URL of the login page, embedded in password-recovery emails.
LOGIN_URL=http://localhost:4321/login

# ---------------------------------------------------------------------------
# Email (password recovery). When EMAIL_USER/EMAIL_PASSWORD are unset, mail is
# mocked to the console (local dev). Set these for real SMTP delivery in prod.
# ---------------------------------------------------------------------------
# EMAIL_USER=you@example.com
# EMAIL_PASSWORD=your-smtp-app-password
# EMAIL_HOST=smtp.exmail.qq.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_FROM="Channel Portal" <you@example.com>

# ---------------------------------------------------------------------------
# Local development server (@vibelingan-channel/local-server)
# ---------------------------------------------------------------------------
PORT=3002
# Path (relative to local-server) where the file-backed local DB is stored.
LOCAL_DB_FILE=./data/db.local.json

# ---------------------------------------------------------------------------
# Astro site (@vibelingan-channel/site) — only PUBLIC_ vars are exposed to the client
# ---------------------------------------------------------------------------
# Absolute public site origin used at build time for canonical URLs and sitemap.
# Test/prod deployments must set this to their actual public origin.
SITE_URL=http://localhost:4321

# When set to 1, the Astro dev server proxies /api/* to PUBLIC_CB_HOST so the
# browser avoids CORS. Point PUBLIC_CB_HOST at the local-server or production.
PUBLIC_CB_PROXY=1
PUBLIC_CB_HOST=localhost:3002

# Optional absolute API origin for deployed static builds when the CloudBase Web
# App domain differs from the HTTP function/API domain.
# PUBLIC_API_BASE_URL=https://example-api-origin.com

# ---------------------------------------------------------------------------
# Alibaba.com Open Platform (alibaba-catalog-sync function)
# ---------------------------------------------------------------------------
# App credentials from the open.alibaba.com developer console (self-developed
# app bound to the merchant's Alibaba.com seller account). Real values live in
# the gitignored .env locally and in CloudBase function env config when
# deployed — never commit them.
ALI_APP_KEY=your-alibaba-app-key
ALI_APP_SECRET=your-alibaba-app-secret

# Absolute HTTPS URL of the OAuth callback, exactly as registered for the app
# on open.alibaba.com. Must resolve to the alibaba-catalog-sync function's
# /oauth/callback route in the target environment.
# ALI_OAUTH_CALLBACK_URL=https://example-api-origin.com/api/alibaba-catalog-sync/oauth/callback

# 32-byte key as exactly 64 lowercase hex characters, for the AES-256-GCM
# envelope that encrypts stored Alibaba OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# The _V1 suffix is the key version; rotation introduces _V2 alongside it.
# ALI_TOKEN_ENCRYPTION_KEY_V1=

# WeCom group-robot webhook for sync/authorization alerts. Optional in local
# dev (alerts fall back to console logging when unset).
# WECOM_WEBHOOK_URL=

# Optional endpoint-base overrides (HTTPS on *.alibaba.com only) — safety
# valve in case the documented GOP defaults differ from the live gateway;
# see docs/alibaba-linked-catalog-sync/ARCHITECTURE.md §8.2.
# ALI_AUTHORIZE_BASE_URL=https://openapi-auth.alibaba.com/oauth/authorize
# ALI_API_BASE_URL=https://openapi-api.alibaba.com/rest
