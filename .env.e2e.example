# Copy to a local shell/export flow. Do not commit real credentials.

# Required for deployed e2e modes.
E2E_SITE_URL=https://<your-cloudbase-webapp>.webapps.tcloudbase.com
E2E_API_URL=https://<your-cloudbase-env>.service.tcloudbase.com

# Required for admin-auth and mutation e2e.
E2E_ADMIN_EMAIL=admin@channel.local
E2E_ADMIN_PASSWORD=

# One-shot bootstrap flow. Only set to 1 immediately before first admin setup.
E2E_ENABLE_BOOTSTRAP=0
E2E_BOOTSTRAP_ADMIN_TOKEN=

# Mutation suites write e2e-prefixed records and clean them up.
E2E_ALLOW_MUTATION=0
