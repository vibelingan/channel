{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "商品 SEO：构建、交付与恢复",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "ci",
      "label": "本地与 CI · 已实现"
    },
    {
      "id": "delivery",
      "label": "现有 test 交付目标 · 分支内实现，未部署"
    },
    {
      "id": "recovery",
      "label": "缓存与恢复 · 方案和内核已有，线上待验收",
      "variant": "exception"
    }
  ],
  "mainPath": ["check", "snapshot", "build", "archive", "backup", "upload", "accept"],
  "nodes": [
    {
      "id": "check",
      "lane": "ci",
      "col": 0,
      "type": "security",
      "label": "代码检查",
      "sublabel": "沿用完整 CI"
    },
    {
      "id": "snapshot",
      "lane": "ci",
      "col": 1,
      "type": "database",
      "label": "采集商品快照",
      "sublabel": "公开 API → JSON"
    },
    {
      "id": "build",
      "lane": "ci",
      "col": 2,
      "type": "backend",
      "label": "从文件构建",
      "sublabel": "Astro SSG + 本地校验"
    },
    {
      "id": "archive",
      "lane": "ci",
      "col": 3,
      "type": "database",
      "label": "保存发布产物",
      "sublabel": "HTML、资源、快照"
    },
    {
      "id": "upload",
      "lane": "delivery",
      "col": 4,
      "type": "cloud",
      "label": "上传与托管配置",
      "sublabel": "404.html · 逐文件上传"
    },
    {
      "id": "accept",
      "lane": "delivery",
      "col": 5,
      "type": "security",
      "label": "公开地址验收",
      "sublabel": "404、缓存、正文、hash"
    },
    {
      "id": "backup",
      "lane": "ci",
      "col": 4,
      "type": "database",
      "label": "备份与写入门禁",
      "sublabel": "核验、归档后检查缓存",
      "width": 216
    },
    {
      "id": "cachefix",
      "lane": "recovery",
      "col": 3,
      "type": "cloud",
      "label": "修复缓存策略",
      "sublabel": "先备份，再配置与读回"
    },
    {
      "id": "restore",
      "lane": "recovery",
      "col": 4,
      "type": "backend",
      "label": "指定产物恢复",
      "sublabel": "先资源后页面，保留旧资源",
      "width": 136
    },
    {
      "id": "recheck",
      "lane": "recovery",
      "col": 5,
      "type": "security",
      "label": "恢复验收",
      "sublabel": "同一组公开地址与 hash"
    }
  ],
  "edges": [
    {
      "from": "check",
      "to": "snapshot"
    },
    {
      "from": "snapshot",
      "to": "build"
    },
    {
      "from": "build",
      "to": "archive"
    },
    {
      "from": "upload",
      "to": "accept"
    },
    {
      "from": "restore",
      "to": "recheck"
    },
    {
      "from": "archive",
      "to": "backup"
    },
    {
      "from": "accept",
      "to": "restore",
      "label": "按需恢复",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "backup",
      "to": "upload",
      "label": "通过"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "现有流水线",
      "items": [
        "SSG 采集或校验失败即停止；已有线上文件仍保留。",
        "发布前完整备份已接入 CI；本轮线上 1,032 个文件已核验。"
      ]
    },
    {
      "dot": "amber",
      "title": "按顺序补齐",
      "items": [
        "备份已完成；缓存补丁、恢复计划和执行内核已备好。",
        "共享锁中的实际恢复、应急 skip、自动发布仍待接入。"
      ]
    },
    {
      "dot": "rose",
      "title": "已知边界",
      "items": [
        "逐文件上传尚无原子切换保证；静态恢复不回滚函数和数据库。",
        "test 是现有交付目标；不会额外搭建测试环境或 Tunnel。"
      ]
    }
  ]
}
