{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "备份时序：工具返回成功后还要验证什么",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1080, 620]
  },
  "participants": [
    {
      "id": "backup_runner",
      "label": "备份脚本",
      "sublabel": "本地校验与封存",
      "type": "backend"
    },
    {
      "id": "cloud_management",
      "label": "CloudBase 管理",
      "sublabel": "登录、清单、配置、文件",
      "type": "cloud"
    },
    {
      "id": "independent_http",
      "label": "公开域名",
      "sublabel": "独立 HTTP 内容读取",
      "type": "external"
    },
    {
      "id": "backup_archive",
      "label": "Artifacts",
      "sublabel": "备份目录与 manifest",
      "type": "database"
    }
  ],
  "messages": [
    {
      "id": "check_backup_auth",
      "from": "backup_runner",
      "to": "cloud_management",
      "label": "auth(status)：核对 READY 与目标 env",
      "y": 171.6,
      "variant": "security"
    },
    {
      "id": "backup_auth_result",
      "from": "cloud_management",
      "to": "backup_runner",
      "label": "返回当前环境；不匹配立即停止",
      "y": 201.84,
      "variant": "return"
    },
    {
      "id": "read_snapshot_a",
      "from": "backup_runner",
      "to": "cloud_management",
      "label": "分页 listFiles；读取 websiteConfig 与域名路由",
      "y": 232.08,
      "variant": "default"
    },
    {
      "id": "snapshot_a_result",
      "from": "cloud_management",
      "to": "backup_runner",
      "label": "返回清单 A、配置 A；核对总量与游标",
      "y": 262.32,
      "variant": "return"
    },
    {
      "id": "download_objects",
      "from": "backup_runner",
      "to": "cloud_management",
      "label": "downloadDirectory；仅补取缺失的明确文件",
      "y": 292.56,
      "variant": "emphasis"
    },
    {
      "id": "download_result",
      "from": "cloud_management",
      "to": "backup_runner",
      "label": "文件已下载；success 不能单独证明完整",
      "y": 322.8,
      "variant": "return"
    },
    {
      "id": "read_multipart_proof",
      "from": "backup_runner",
      "to": "independent_http",
      "label": "对 multipart ETag 文件额外 GET，要求 no-cache",
      "y": 353.04,
      "variant": "default"
    },
    {
      "id": "multipart_proof_result",
      "from": "independent_http",
      "to": "backup_runner",
      "label": "返回正文与 ETag；脚本计算长度和 SHA-256",
      "y": 383.28,
      "variant": "return"
    },
    {
      "id": "read_snapshot_b",
      "from": "backup_runner",
      "to": "cloud_management",
      "label": "重新读取完整清单 B 与配置 B",
      "y": 413.52,
      "variant": "default"
    },
    {
      "id": "snapshot_b_result",
      "from": "cloud_management",
      "to": "backup_runner",
      "label": "脚本比较 A/B，并核对所有文件与 ETag",
      "y": 443.76,
      "variant": "return"
    },
    {
      "id": "seal_and_archive_backup",
      "from": "backup_runner",
      "to": "backup_archive",
      "label": "全量通过后封存 files、配置和 recovery-manifest",
      "y": 474.0,
      "variant": "emphasis"
    },
    {
      "id": "archive_backup_result",
      "from": "backup_archive",
      "to": "backup_runner",
      "label": "上传 artifact 成功后，发布才可继续",
      "y": 504.24,
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "每个文件怎样验证",
      "items": [
        "普通 ETag：长度与 MD5 对照；所有文件再记录 SHA-256。",
        "分片 ETag 不当作 MD5，须匹配独立 HTTP 读取的证据。"
      ]
    },
    {
      "dot": "rose",
      "title": "哪些情况必须停止",
      "items": [
        "游标缺失、总量变化、A/B 配置或文件版本变化。",
        "补取后仍缺文件、长度/hash 不符、分片证据不完整。"
      ]
    },
    {
      "dot": "amber",
      "title": "已有证据与后续执行",
      "items": [
        "本轮手动核验过 1,032 个线上文件；新脚本已在本地验证。",
        "自动备份及归档的真实 GitHub 执行仍待验收。"
      ]
    }
  ]
}
