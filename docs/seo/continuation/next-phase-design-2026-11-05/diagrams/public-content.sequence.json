  "cards": [
    {
      "dot": "cyan",
      "title": "新增在现有链路上",
      "items": ["分类补初始链接和分页；图片先准备可用版本", "CDN 首期只分发脚本样式，不接管 HTML"]
    },
    {
      "dot": "emerald",
      "title": "两种内容分别处理",
      "items": [
        "商品变化更新初始 HTML；浏览器仍查实时 API",
        "Blog 发布不等 GitHub，也不等五分钟定时器"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复与搜索分开",
      "items": ["技术恢复保留当前文章、商品和发布状态", "地图/重抓是提示，不是主动把网页送入索引"]
