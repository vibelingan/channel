{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "图文草稿：文件交接到后台审核",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "content",
      "label": "客户与内容机：已有稿件和真实图片"
    },
    {
      "id": "publisher",
      "label": "发布机与网站：受限上传和图文草稿"
    },
    {
      "id": "operations",
      "label": "失败回执与人工公开"
    }
  ],
  "mainPath": ["customer", "writer", "kb", "handoff", "verify", "draft", "review", "public"],
  "nodes": [
    {
      "id": "customer",
      "lane": "content",
      "col": 0,
      "type": "external",
      "label": "客户下任务",
      "sublabel": "只说业务需求",
      "width": 145
    },
    {
      "id": "writer",
      "lane": "content",
      "col": 1,
      "type": "backend",
      "label": "已有文章与两图",
      "sublabel": "保留原稿，不重新生成",
      "width": 145
    },
    {
      "id": "kb",
      "lane": "content",
      "col": 2,
      "type": "database",
      "label": "登记图片文件",
      "sublabel": "来源、大小、摘要",
      "width": 145
    },
    {
      "id": "handoff",
      "lane": "content",
      "col": 3,
      "type": "messagebus",
      "label": "受限SSH传文件",
      "sublabel": "只接收本站任务图片",
      "tag": "已验收",
      "width": 155
    },
    {
      "id": "verify",
      "lane": "publisher",
      "col": 3,
      "type": "security",
      "label": "网站授上传权限",
      "sublabel": "单文件、短期、限本篇",
      "width": 155
    },
    {
      "id": "draft",
      "lane": "publisher",
      "col": 4,
      "type": "backend",
      "label": "上传、校验、插图",
      "sublabel": "图片编号、说明、位置",
      "width": 155
    },
    {
      "id": "review",
      "lane": "publisher",
      "col": 5,
      "type": "frontend",
      "label": "人工审核",
      "sublabel": "检查正文、图片、预览",
      "width": 145
    },
    {
      "id": "ordinary",
      "lane": "operations",
      "col": 1,
      "type": "backend",
      "label": "缺图明确返回",
      "sublabel": "保留已完成步骤",
      "width": 145
    },
    {
      "id": "keys",
      "lane": "operations",
      "col": 3,
      "type": "security",
      "label": "网站存储身份",
      "sublabel": "不交给两台助手",
      "tag": "复用既有SDK",
      "width": 155
    },
    {
      "id": "public",
      "lane": "operations",
      "col": 5,
      "type": "cloud",
      "label": "人确认后上线",
      "sublabel": "本轮未执行，需人确认",
      "width": 145
    }
  ],
  "edges": [
    {
      "id": "request",
      "from": "customer",
      "to": "writer"
    },
    {
      "id": "store",
      "from": "writer",
      "to": "kb"
    },
    {
      "id": "ask-draft",
      "from": "kb",
      "to": "handoff"
    },
    {
      "id": "get-document",
      "from": "handoff",
      "to": "verify",
      "label": "文档与图片",
      "variant": "emphasis"
    },
    {
      "id": "save",
      "from": "verify",
      "to": "draft"
    },
    {
      "id": "link",
      "from": "draft",
      "to": "review",
      "label": "编辑链接"
    },
    {
      "id": "approve",
      "from": "review",
      "to": "public",
      "label": "人点上线",
      "variant": "emphasis"
    },
    {
      "id": "credential",
      "from": "keys",
      "to": "verify",
      "label": "SDK签名",
      "variant": "security"
    },
    {
      "id": "incomplete-image",
      "from": "draft",
      "to": "ordinary",
      "label": "图片未全部完成",
      "variant": "dashed",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "私有草稿已验收",
      "items": ["203原稿、两张原图、版本2，文字保留", "刷新和预览正常，重投不增图，旧版本拒绝"]
    },
    {
      "dot": "amber",
      "title": "接下来由客户群测",
      "items": ["内容机实际工具到网站通过，群内任务待验收", "网站钥匙只留发布机，图片公开需人审核"]
    }
  ]
}
