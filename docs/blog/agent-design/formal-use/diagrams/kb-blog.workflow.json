      "width": 145
    },
    {
      "id": "writer",
      "lane": "content",
      "col": 1,
      "type": "backend",
      "label": "内容助手创作",
      "sublabel": "正文、摘要、配图",
      "width": 145
    },
    {
      "id": "kb",
      "lane": "content",
      "col": 2,
