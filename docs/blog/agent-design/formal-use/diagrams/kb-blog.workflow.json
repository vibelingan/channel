    },
    {
      "id": "approve",
      "from": "review",
      "to": "public",
      "label": "人点上线",
      "variant": "emphasis"
    },
    {
      "id": "ordinary-work",
      "from": "writer",
      "to": "ordinary",
      "label": "未要求存网站",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "credential",
      "from": "keys",
      "to": "verify",
      "label": "受限凭证",
      "variant": "security"
    }
