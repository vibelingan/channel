      "sublabel": "编辑、补图、预览",
      "width": 145
    },
    {
      "id": "ordinary",
      "lane": "operations",
      "col": 1,
      "type": "backend",
      "label": "其他内容任务",
      "sublabel": "保留原工作流程",
      "width": 145
    },
    {
      "id": "keys",
      "lane": "operations",
      "col": 3,
      "type": "security",
      "label": "凭证自动维护",
      "sublabel": "仅发布机持有",
      "tag": "代码已测，待启用",
      "width": 155
    },
    {
      "id": "public",
      "lane": "operations",
      "col": 5,
      "type": "cloud",
      "label": "客户确认上线",
      "sublabel": "网站返回文章 HTML",
      "width": 145
    }
