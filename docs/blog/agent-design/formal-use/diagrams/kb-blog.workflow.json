  "cards": [
    {
      "dot": "cyan",
      "title": "已在发布机完成",
      "items": ["写作职责已移除；取稿和草稿工具保留", "其他 MCP 与 A2A 服务保持原样"]
    },
    {
      "dot": "rose",
      "title": "代码验证与待接事项",
      "items": ["同文档去重与凭证维护已做离线测试", "工作区和任务入口等自查后接线联测"]
    }
