  "edges": [
    {
      "id": "request",
      "from": "customer",
      "to": "writer"
    },
    {
      "id": "store",
      "from": "writer",
      "to": "kb"
    },
    {
      "id": "ask-draft",
      "from": "kb",
      "to": "handoff"
    },
    {
      "id": "get-document",
      "from": "handoff",
      "to": "verify",
      "label": "指定文档",
      "variant": "emphasis"
    },
    {
      "id": "save",
