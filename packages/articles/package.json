{
  "name": "@vibelingan-channel/articles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned article documents, safe rendering and draft rules; no editor, database or network runtime.",
  "exports": {
    ".": "./src/index.ts",
    "./drafts": "./src/drafts.ts",
    "./draft-repository": "./src/draft-repository.ts",
    "./draft-service": "./src/draft-service.ts",
    "./document": "./src/document.ts",
    "./media": "./src/media.ts",
    "./media-store": "./src/media-store.ts",
    "./publication": "./src/publication.ts",
    "./release": "./src/release.ts",
    "./release-store": "./src/release-store.ts",
    "./release-service": "./src/release-service.ts",
    "./transaction-store": "./src/transaction-store.ts",
    "./build": "./src/build.ts",
    "./release-build": "./src/release-build.ts",
    "./public-read": "./src/public-read.ts",
    "./import": "./src/import.ts",
    "./import-store": "./src/import-store.ts",
    "./import-media": "./src/import-media.ts"
  },
  "scripts": {
    "test": "tsc --noEmit && tsx --test \"src/**/*.test.ts\"",
