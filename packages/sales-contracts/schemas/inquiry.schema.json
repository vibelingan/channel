{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:channel:sales:inquiry:1.0",
  "title": "InquirySubmitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "client_id",
    "business_line",
    "source_installation_id",
    "source",
    "source_record_id",
    "source_revision",
    "submitted_at",
    "contact",
    "requirements",
    "product_snapshot_refs",
    "attachment_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "business_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "enum": [
        "website_oem",
        "website_product",
        "website_assistant"
      ]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$",
      "maxLength": 27,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "company": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_summary"
      ],
      "properties": {
        "confirmed_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "product_snapshot_refs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "attachment_refs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1800
      }
    }
  }
}
