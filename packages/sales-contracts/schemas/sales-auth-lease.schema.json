{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:channel:sales:auth:lease:1",
  "title": "TaskReadLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client_id",
    "business_line",
    "source_installation_id",
    "environment",
    "runtime_id",
    "control_epoch",
    "task_id",
    "run_id",
    "task_revision",
    "connection_id",
    "lease_sha256",
    "handoff_sha256",
    "source",
    "asset_refs",
    "product_scope",
    "allowed_actions",
    "audience",
    "issued_at",
    "expires_at",
    "revoked"
  ],
  "properties": {
    "protocol": {
      "const": "sales-auth/1"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "business_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "source_installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "environment": {
      "enum": [
        "test",
        "production"
      ]
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "lease_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "oem",
            "product"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        }
      }
    },
    "asset_refs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1800,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "product_scope": {
      "const": "approved_catalog"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inquiry.read",
          "product.read",
          "asset.read"
        ]
      }
    },
    "audience": {
      "const": "channel.sales.read"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revoked": {
      "type": "boolean"
    }
  }
}
