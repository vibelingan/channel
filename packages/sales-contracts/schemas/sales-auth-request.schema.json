          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        },
        "environment": {
          "enum": [
            "test",
            "production"
          ]
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        },
