          "minimum": 0,
          "maximum": 9007199254740991
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        },
        "lease_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "handoff_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
