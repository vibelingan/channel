        "handoff_sha256",
        "request_id",
        "action",
        "resource"
      ],
      "properties": {
        "protocol": {
          "const": "sales-auth/1"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
        },
        "business_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
