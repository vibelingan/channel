{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:channel:sales:auth:authority:1",
  "title": "TaskAuthority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client_id",
    "business_line",
    "source_installation_id",
    "environment",
    "runtime_id",
    "control_epoch",
    "task_id",
    "run_id",
    "task_revision",
    "handoff_sha256",
    "source_verified",
    "mode",
    "work_state",
    "allowed_actions"
  ],
  "properties": {
    "protocol": {
      "const": "sales-auth/1"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "business_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "source_installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "environment": {
      "enum": [
        "test",
        "production"
      ]
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:/.-]*$"
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_verified": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "agent_active",
        "paused",
        "human_owned",
        "disabled",
        "cancelled"
      ]
    },
    "work_state": {
      "enum": [
        "preparing",
        "waiting",
        "review_ready",
        "finished",
        "failed"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inquiry.read",
          "product.read",
          "asset.read"
        ]
      }
    }
  }
}
