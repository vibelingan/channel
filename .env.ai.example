# Copy to .env.ai (gitignored) and fill in. Never commit the real file.
#
# zenmux API key — the model provider.
#
# Copy it from your password manager into this file directly. Do not print it,
# do not echo it, and do not read it out of another tool's auth store on the
# command line: anything that puts the value on stdout puts it in a shell
# history, a terminal scrollback, and any transcript of this session.
#
# Use a development-scoped key with its own spend cap, never the production one.
GENERIC_OPEN_AI_API_KEY=

# Override when another local project already owns the default 55432 port.
AI_POSTGRES_PORT=55432

# Set on first run, then reused. Any long random string.
JWT_SECRET=
SIG_KEY=
SIG_SALT=

# Optional local AnythingLLM profile. `pnpm dev:ai` ignores this profile and
# uses the deterministic fake engine; `pnpm dev:ai:build` reads this file and
# starts the pinned local image. The worker will not start until the API key,
# its non-secret attestation id, corpus, and citation verification are real.
AI_ENGINE_ID=anythingllm
AI_ENGINE_VERSION=1.16.0
AI_ENGINE_PROVENANCE_KIND=oci
AI_ENGINE_IMAGE_DIGEST=sha256:68bcedecb720e3fadde986bcc4f3aad20059fa64805bc9b306a3023244947515
ANYTHINGLLM_BASE_URL=http://anythingllm:3001
# Host-side helper only; never use the container hostname here.
ANYTHINGLLM_LOCAL_ADMIN_URL=http://127.0.0.1:53001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_SLUG=channel-public-assistant
ANYTHINGLLM_WORKSPACE_ID=
# First 16 lowercase hex characters of SHA-256(ANYTHINGLLM_API_KEY).
AI_KNOWLEDGE_CREDENTIAL_ID=
ANYTHINGLLM_CREDENTIAL_ROTATION=1
AI_CORPUS_GENERATION=
# `pnpm test:ai:kb` writes this secret-free file. Compose mounts it read-only
# into the worker; use AI_KB_EVIDENCE_JSON instead on CloudRun.
AI_KB_EVIDENCE_FILE=.ai-kb-evidence.json
AI_KB_EVIDENCE_HOST_FILE=.ai-kb-evidence.json
# Change to 1 only after a live citation-bearing probe of this exact workspace.
ANYTHINGLLM_CITATIONS_VERIFIED=0
AI_APPROVED_SOURCE_PREFIX=channelkb
AI_SITE_ORIGIN=http://localhost:4321
# Safe only inside this loopback-bound Docker network; forbidden in production.
ALLOW_INSECURE_ANYTHINGLLM=true
