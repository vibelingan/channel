# Copy to .env.ai (gitignored) and fill in. Never commit the real file.
#
# zenmux API key — the model provider.
#
# Copy it from your password manager into this file directly. Do not print it,
# do not echo it, and do not read it out of another tool's auth store on the
# command line: anything that puts the value on stdout puts it in a shell
# history, a terminal scrollback, and any transcript of this session.
#
# Use a development-scoped key with its own spend cap, never the production one.
GENERIC_OPEN_AI_API_KEY=

# Override when another local project already owns the default 55432 port.
AI_POSTGRES_PORT=55432

# Set on first run, then reused. Any long random string.
JWT_SECRET=
SIG_KEY=
SIG_SALT=
