# Copy to .env.ai (gitignored) and fill in. Never commit the real file.
#
# zenmux API key. On this machine the existing key is already in opencode's
# auth store; read it with:
#   node -e "console.log(JSON.parse(require('fs').readFileSync(process.env.HOME+'/.local/share/opencode/auth.json','utf8')).zenmux.key)"
# Do NOT paste it into chat, a commit, or a command line.
GENERIC_OPEN_AI_API_KEY=

# Set on first run, then reused. Any long random string.
JWT_SECRET=
SIG_KEY=
SIG_SALT=
