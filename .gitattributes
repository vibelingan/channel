# Normalize line endings for the whole repo.
# Text files are stored with LF in the repo and checked out with LF.
* text=auto eol=lf

# Explicit common text types (optional, for clarity)
*.md   text eol=lf
*.txt  text eol=lf

# Windows-specific scripts should keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never modify
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary

